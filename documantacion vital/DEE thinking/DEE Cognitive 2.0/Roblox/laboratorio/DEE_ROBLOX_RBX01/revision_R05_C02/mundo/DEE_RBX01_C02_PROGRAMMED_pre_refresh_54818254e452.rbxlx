			</Properties>
			<Item class="LocalScript" referent="RBX321">
				<Properties>
					<ProtectedString name="Source">-- Spectator UI only. It cannot submit observations, select exits, choose lives, or move DEE.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local HttpService=game:GetService("HttpService")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local gui=Instance.new("ScreenGui")
gui.Name="RBX01_Spectator";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=false;gui.Parent=player:WaitForChild("PlayerGui")
local function label(name,size,pos,text,color)
    local l=Instance.new("TextLabel")
    l.Name=name;l.Size=size;l.Position=pos;l.BackgroundTransparency=1;l.TextColor3=color or Color3.fromRGB(231,243,247)
    l.Font=Enum.Font.GothamMedium;l.TextScaled=true;l.TextWrapped=true;l.TextXAlignment=Enum.TextXAlignment.Left;l.Text=text;l.Parent=gui
    local cap=Instance.new("UITextSizeConstraint");cap.MaxTextSize=24;cap.MinTextSize=11;cap.Parent=l
    return l
end
local backdrop=Instance.new("Frame");backdrop.Name="Instrumentos";backdrop.Size=UDim2.new(.95,0,.31,0);backdrop.Position=UDim2.new(.025,0,.025,0)
backdrop.BackgroundColor3=Color3.fromRGB(9,22,35);backdrop.BackgroundTransparency=.13;backdrop.BorderSizePixel=0;backdrop.Parent=gui
local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,12);corner.Parent=backdrop
local title=label("Mode",UDim2.new(.9,0,.045,0),UDim2.new(.05,0,.035,0),"RBX01 | ESPERA | L4",Color3.fromRGB(100,232,235))
local life=label("Life",UDim2.new(.9,0,.03,0),UDim2.new(.05,0,.085,0),"VIDA PENDIENTE")
local clock=label("Clock",UDim2.new(.9,0,.035,0),UDim2.new(.05,0,.12,0),"TICK — | MUNDO 0s | ESCALA 2x")
local obs=label("Observation",UDim2.new(.9,0,.045,0),UDim2.new(.05,0,.16,0),"OBSERVACION —")
local act=label("Action",UDim2.new(.9,0,.04,0),UDim2.new(.05,0,.205,0),"SELECCION / ACCION —")
local consequence=label("Consequence",UDim2.new(.9,0,.035,0),UDim2.new(.05,0,.25,0),"CONSECUENCIA —")
local bottom=label("Stock",UDim2.new(.9,0,.04,0),UDim2.new(.05,0,.29,0),"PERMISOS — | LATENCIA —")
local notice=label("Notice",UDim2.new(.9,0,.07,0),UDim2.new(.05,0,.76,0),"OBJETIVO: LLAVE → RECURSO → ENTREGA EN BASE.\nEspectador: el puente conserva las selecciones Native.")
local remote=ReplicatedStorage:WaitForChild("RBX01Control")
local buttons={{"INICIAR","START_NATIVE"},{"CONTROL","START_CONTROL"},{"PAUSA","PAUSE"},{"GUARDAR / CERRAR","SAVE_CLOSE"},{"CAMARA","CAMERA"}}
local view=0
for i,item in ipairs(buttons) do
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(.177,0,.066,0);b.Position=UDim2.new(.025+(i-1)*.193,0,.87,0)
    b.BackgroundColor3=Color3.fromRGB(22,63,81);b.TextColor3=Color3.new(1,1,1);b.Font=Enum.Font.GothamBold;b.TextScaled=true;b.TextWrapped=true;b.Text=item[1];b.Parent=gui
    local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,8);c.Parent=b
    local cap=Instance.new("UITextSizeConstraint");cap.MaxTextSize=18;cap.MinTextSize=10;cap.Parent=b
    b.Activated:Connect(function() if item[2]=="CAMERA" then view=(view+1)%3 else remote:FireServer(item[2]) end end)
end
local status=ReplicatedStorage:WaitForChild("RBX01Status")
local function update()
    local ok,s=pcall(function() return HttpService:JSONDecode(status.Value) end)
    if not ok then return end
    local mode=s.mode=="LIVE_NATIVE" and "LIVE NATIVE" or s.mode=="WAIT" and "ESPERA" or s.mode
    title.Text="DEE / RBX01  |  "..mode.."  |  "..s.level..(s.reserveActive and " RESERVA" or "").."  |  "..s.cycle.."/"..s.maxCycles
    life.Text="VIDA "..s.lifeId
    clock.Text=string.format("TICK %s  |  MUNDO %.1fs  |  %.1fx / ACCION",tostring(s.nativeTick),s.worldTime,s.timeScale)
    obs.Text="OBS: "..s.observation
    act.Text="SELECCION / ACCION: "..s.action
    consequence.Text="EFECTO: "..s.consequence
    bottom.Text=string.format("PERMISOS %d  |  ENTREGAS %d  |  LATENCIA %.1fs",s.permissionStock,s.delivered,s.latency)
    notice.Text=s.reason.."\nLLAVE "..(s.inventoryKey and "SI" or "NO").." / RECURSO "..(s.inventoryResource and "SI" or "NO").." / ESTACION "..s.station
end
status.Changed:Connect(update);update()
RunService.RenderStepped:Connect(function()
    local camera=workspace.CurrentCamera
    local body=workspace:FindFirstChild("RBX01") and workspace.RBX01:FindFirstChild("DEE_Body")
    if not camera or not body or not body.PrimaryPart then return end
    camera.CameraType=Enum.CameraType.Scriptable
    local focus=body.PrimaryPart.Position
    local position=view==0 and Vector3.new(105,150,150) or view==1 and focus+Vector3.new(28,37,38) or Vector3.new(-115,98,-115)
    local target=view==1 and focus or Vector3.new(0,3,5)
    camera.CFrame=CFrame.lookAt(position,target)
    camera.FieldOfView=view==1 and 63 or 59
end)
</ProtectedString>
