<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><Item class="Model" referent="RBX_DEE_PACKAGE"><Properties><string name="Name">DEEConnector_R07</string></Properties><Item class="ModuleScript" referent="RBX_Main"><Properties><string name="Name">Main</string><ProtectedString name="Source">-- DEE reusable server connector. Backend decisions remain outside this module.
-- No HTTP, secret, Native query, target solver, player kick or auto-start.
local Http=game:GetService("HttpService")
local Storage=game:GetService("ServerStorage")
local Tags=game:GetService("CollectionService")
local Run=game:GetService("RunService")
local Binding=require(script.Parent.BackendBinding)
local M={Schema="DEE.RBX.Connector.R01"}
local runtimes={}
local Agent={};Agent.__index=Agent
local Runtime={};Runtime.__index=Runtime
local function copy(v)return Http:JSONDecode(Http:JSONEncode(v))end
local function id(v)
    assert(type(v)=="string"and #v&gt;0 and #v&lt;=96 and not string.find(v,"[^%w_%-]"),"DEE_SAFE_ID_REQUIRED")
    return v
end
local function integer(v)return type(v)=="number"and v%1==0 and v&gt;=0 end
local function guid(prefix)return prefix.."_"..Http:GenerateGUID(false)end
local function value(parent,class,name,initial)
    local v=Instance.new(class);v.Name=name;v.Value=initial;v.Parent=parent;return v
end
local function folder(parent,name)
    local f=Instance.new("Folder");f.Name=name;f.Parent=parent;return f
end
local function decode(raw)
    assert(type(raw)=="string"and #raw&lt;=65536,"DEE_MESSAGE_BOUND")
    local ok,v=pcall(Http.JSONDecode,Http,raw);assert(ok and type(v)=="table","DEE_JSON_OBJECT_REQUIRED");return v
end
function Agent:_save()
    self.node.State.Value=Http:JSONEncode(self.s)
    self.node.ActionCursor.Value=self.s.actionCursor
    self.node.OpportunityCursor.Value=self.s.completedOpportunities
    self.node.Sequence.Value=self.s.sequence
    self.node:SetAttribute("Phase",self.s.phase)
end
function Agent:_exclusive(fn)
    assert(not self.busy,"DEE_CONCURRENT_ENTITY_CALL")
    self.busy=true;local ok,result=pcall(fn);self.busy=false
    if not ok then error(result,0)end;return result
end
function Agent:_identity(message)
    assert(message.protocol==M.Schema and message.namespace==self.namespace,"DEE_TRANSPORT_NAMESPACE")
    assert(message.sessionId==self.s.sessionId,"DEE_TRANSPORT_SESSION")
end
function Agent:bindSession(context)
    return self:_exclusive(function()
        assert(self.s.phase=="PREPARED"and self.s.sessionId=="","DEE_NO_SESSION_OVERWRITE")
        self.s.sessionId=id(context.sessionId);self.s.lifeId=id(context.lifeId)
        assert(integer(context.nativeTick),"DEE_TICK_REQUIRED")
        self.s.nativeTick=context.nativeTick;self.s.phase="BOUNDARY";self:_save()
        return self:status()
    end)
end
function Agent:observe(phase)
    return self:_exclusive(function()
        local continuation=self.s.phase=="ACTION_ACKNOWLEDGED"and self.s.observation.phase=="QUERY_CHOICE"
            and self.s.lastActionName~="SAFE_WAIT"and phase=="ROUTE_CHOICE"
        assert(self.s.phase=="BOUNDARY"or continuation,"DEE_OBSERVE_PHASE")
        assert(not self.s.closeRequested,"DEE_CLOSE_REQUESTED")
        assert(phase=="QUERY_CHOICE"or phase=="ROUTE_CHOICE","DEE_OBSERVATION_PHASE")
        assert(self.s.completedOpportunities&lt;self.config.MaxOpportunities,"DEE_HORIZON_CLOSED")
        local observation=self.adapters.sensors:observe(phase)
        assert(type(observation)=="table"and type(observation.sensors)=="table","DEE_SENSOR_CONTRACT")
        self.s.sequence+=1
        observation.protocol=M.Schema;observation.namespace=self.namespace;observation.sessionId=self.s.sessionId
        observation.observationId=guid("obs");observation.seq=self.s.sequence
        observation.opportunity=self.s.completedOpportunities+1;observation.phase=phase
        observation.previousActionId=self.s.lastActionId
        self.s.observation=copy(observation);self.s.phase="AWAIT_ACTION"
        self.node.Observation.Value=Http:JSONEncode(observation);self:_save();return copy(observation)
    end)
end
function Agent:deliverAction(raw)
    return self:_exclusive(function()
        local message=decode(raw);self:_identity(message)
        local actionId=id(message.actionId);local operationId=id(message.operationId)
        local prior=self.node.Actions:FindFirstChild(actionId)
        if prior then
            local receipt=decode(prior.Value)
            assert(receipt.rawRequest==raw,"DEE_ACTION_ID_CONFLICT")
            assert(receipt.status=="EXECUTED"or receipt.status=="ACKNOWLEDGED"or receipt.status=="COMMITTED","DEE_PARTIAL_ACTION_PRESERVED")
            return copy(receipt.ack) -- no physical replay, no new ACK fabricated
        end
        assert(self.s.phase=="AWAIT_ACTION","DEE_ACTION_PHASE")
        assert(message.observationId==self.s.observation.observationId and message.seq==self.s.sequence,"DEE_OBSERVATION_CORRELATION")
        assert(type(message.action)=="table"and type(message.action.name)=="string","DEE_ACTION_CONTRACT")
        local technical=message.sourceKind=="MCP_TECHNICAL_CONTROL"
        assert(message.sourceKind==self.binding.sourceKind or(technical and self.config.AllowTechnicalTest==true),"DEE_DECISION_SOURCE")
        assert(#self.node.Actions:GetChildren()&lt;self.config.MaxActions,"DEE_ACTION_LEDGER_BOUND")
        local receipt={status="PREPARED",rawRequest=raw,operationId=operationId,technical=technical}
        local entry=value(self.node.Actions,"StringValue",actionId,Http:JSONEncode(receipt))
        self.s.phase="EXECUTING";self.s.pendingActionId=actionId;self.s.pendingOperationId=operationId;self:_save()
        local ok,result=pcall(self.adapters.body.execute,self.adapters.body,copy(message.action))
        if not ok then
            receipt.status="UNCERTAIN";receipt.error=tostring(result);entry.Value=Http:JSONEncode(receipt)
            self.s.phase="FAILED_PRESERVED";self.s.lastError=tostring(result);self:_save()
            error("DEE_BODY_EXECUTION_PRESERVED:"..tostring(result),0)
        end
        assert(type(result)=="table","DEE_BODY_RESULT_REQUIRED")
        local ack={protocol=M.Schema,namespace=self.namespace,sessionId=self.s.sessionId,
            actionId=actionId,operationId=operationId,observationId=message.observationId,seq=message.seq,
            executionStatus="EXECUTED",result=copy(result),technicalControl=technical}
        receipt.status="EXECUTED";receipt.ack=ack;entry.Value=Http:JSONEncode(receipt)
        self.node.ActionInbox.Value=raw;self.node.ActionAck.Value=Http:JSONEncode(ack)
        self.s.result=copy(result);self.s.lastActionName=message.action.name
        self.s.phase="AWAIT_ACTION_ACK";self:_save();return copy(ack)
    end)
end
function Agent:confirmActionAck(actionId,operationId)
    return self:_exclusive(function()
        assert(self.s.phase=="AWAIT_ACTION_ACK"and actionId==self.s.pendingActionId and operationId==self.s.pendingOperationId,"DEE_EXACT_ACTION_ACK")
        local entry=assert(self.node.Actions:FindFirstChild(actionId));local receipt=decode(entry.Value)
        receipt.status="ACKNOWLEDGED";entry.Value=Http:JSONEncode(receipt)
        self.s.lastActionId=actionId;self.s.actionCursor+=1
        self.s.phase="ACTION_ACKNOWLEDGED";self.node.ActionAck.Value="";self.node.ActionInbox.Value="";self:_save()
        return self:status()
    end)
end
function Agent:toolRequest()
    assert(self.s.phase=="ACTION_ACKNOWLEDGED","DEE_TOOL_ORDER")
    if type(self.adapters.body.toolRequest)~="function"then return nil end
    local tool=self.adapters.body:toolRequest(copy(self.s.result),copy(self.s.observation))
    return tool and copy(tool)or nil
end
function Agent:deliverTool(raw)
    return self:_exclusive(function()
        local message=decode(raw);self:_identity(message);local operationId=id(message.operationId)
        assert(message.actionId==self.s.lastActionId,"DEE_TOOL_ACTION_CORRELATION")
        local old=self.node.Tools:FindFirstChild(operationId)
        if old then local item=decode(old.Value);assert(item.rawRequest==raw and item.status=="APPLIED","DEE_TOOL_ID_CONFLICT_OR_PARTIAL");return copy(item.ack)end
        assert(self.s.phase=="ACTION_ACKNOWLEDGED"and type(self.adapters.body.applyTool)=="function","DEE_TOOL_NOT_AVAILABLE")
        assert(type(message.toolResult)=="table","DEE_TOOL_RESULT_REQUIRED")
        local record={status="PREPARED",rawRequest=raw};local entry=value(self.node.Tools,"StringValue",operationId,Http:JSONEncode(record))
        self.s.phase="APPLYING_TOOL";self:_save()
        local ok,result=pcall(self.adapters.body.applyTool,self.adapters.body,copy(message.toolResult),self.s.result)
        if not ok then self.s.phase="FAILED_PRESERVED";record.status="UNCERTAIN";record.error=tostring(result);entry.Value=Http:JSONEncode(record);self:_save();error(result,0)end
        assert(result=="APPLIED"or result=="NO_RESULT","DEE_TOOL_APPLICATION_STATUS")
        record.ack={protocol=M.Schema,namespace=self.namespace,sessionId=self.s.sessionId,operationId=operationId,actionId=message.actionId,executionStatus=result}
        record.status="APPLIED";entry.Value=Http:JSONEncode(record)
        self.s.toolOperationId=operationId;self.s.phase="AWAIT_TOOL_ACK";self.node.ToolAck.Value=Http:JSONEncode(record.ack);self:_save();return copy(record.ack)
    end)
end
function Agent:confirmToolAck(operationId)
    return self:_exclusive(function()
        assert(self.s.phase=="AWAIT_TOOL_ACK"and self.s.toolOperationId==operationId,"DEE_EXACT_TOOL_ACK")
        self.node.ToolAck.Value="";self.s.phase="TOOL_ACKNOWLEDGED";self:_save();return self:status()
    end)
end
function Agent:completeFeedback(context)
    return self:_exclusive(function()
        assert(self.s.phase=="ACTION_ACKNOWLEDGED"or self.s.phase=="TOOL_ACKNOWLEDGED","DEE_FEEDBACK_PHASE")
        assert(context.actionId==self.s.lastActionId,"DEE_FEEDBACK_ACTION")
        if self.s.observation.phase=="QUERY_CHOICE"then assert(self.s.lastActionName=="SAFE_WAIT","DEE_QUERY_NEEDS_ROUTE_OR_WAIT")end
        self.s.lastFeedbackOperationId=id(context.feedbackOperationId)
        assert(integer(context.nativeTick),"DEE_FEEDBACK_TICK")
        self.s.nativeTick=context.nativeTick;self.s.completedOpportunities+=1
        local entry=assert(self.node.Actions:FindFirstChild(context.actionId));local r=decode(entry.Value);r.status="COMMITTED";entry.Value=Http:JSONEncode(r)
        self.s.pendingActionId=nil;self.s.pendingOperationId=nil;self.s.toolOperationId=nil
        self.s.phase="BOUNDARY";self.s.result=nil;self.node.Observation.Value="";self:_save();return self:status()
    end)
end
function Agent:requestClose()
    self.s.closeRequested=true;self:_save();return self:status()
end
function Agent:status()return copy(self.s)end
function Agent:capture(context)
    assert(self.s.phase=="BOUNDARY"and self.node.ActionAck.Value==""and self.node.ToolAck.Value=="","DEE_CHECKPOINT_BOUNDARY_ONLY")
    assert(context.backendWriterClosed==true and context.bridgeQuiescent==true,"DEE_CLOSED_PAIR_PROOF_REQUIRED")
    assert(context.sessionId==self.s.sessionId and context.lifeId==self.s.lifeId and context.nativeTick==self.s.nativeTick,"DEE_PAIR_CONTEXT")
    local actions,tools={},{}
    for _,entry in ipairs(self.node.Actions:GetChildren())do
        local item=decode(entry.Value);assert(item.status=="ACKNOWLEDGED"or item.status=="COMMITTED","DEE_PENDING_RECEIPT_PRESERVED")
        actions[entry.Name]=item
    end
    for _,entry in ipairs(self.node.Tools:GetChildren())do tools[entry.Name]=decode(entry.Value)end
    return {schema="DEE.RBX.AgentWorldCheckpoint.R01",namespace=self.namespace,scenarioFingerprint=self.runtime.config.ScenarioFingerprint,
        state=copy(self.s),actions=actions,tools=tools,body=self.adapters.body:capture(),world=self.adapters.world:capture(),
        scope="WORLD_AND_TRANSPORT_ONLY_REQUIRES_COMPLETE_MATCHING_NATIVE_SERVICE",backend=copy(context)}
end
function Agent:restore(state,expected)
    return self:_exclusive(function()
        assert(self.s.phase=="PREPARED"and self.s.actionCursor==0 and #self.node.Actions:GetChildren()==0,"DEE_FRESH_RESTORE_ONLY")
        assert(state.schema=="DEE.RBX.AgentWorldCheckpoint.R01"and state.namespace==self.namespace and state.scenarioFingerprint==self.runtime.config.ScenarioFingerprint,"DEE_CHECKPOINT_IDENTITY")
        assert(expected.backendWriterClosed==true and expected.bridgeQuiescent==true and type(expected.checkpointSha256)=="string"and #expected.checkpointSha256==64 and not string.find(expected.checkpointSha256,"[^0-9a-f]"),"DEE_EXTERNAL_PAIR_ANCHOR")
        assert(expected.sessionId==state.state.sessionId and expected.lifeId==state.state.lifeId and expected.nativeTick==state.state.nativeTick,"DEE_RESTORE_PAIR_CONTEXT")
        assert(state.state.phase=="BOUNDARY"and state.state.pendingActionId==nil,"DEE_RESTORE_BOUNDARY")
        self.adapters.world:restore(copy(state.world));self.adapters.body:restore(copy(state.body))
        for key,item in pairs(state.actions)do id(key);value(self.node.Actions,"StringValue",key,Http:JSONEncode(item))end
        for key,item in pairs(state.tools)do id(key);value(self.node.Tools,"StringValue",key,Http:JSONEncode(item))end
        self.s=copy(state.state);self.s.closeRequested=false;self:_save();return self:status()
    end)
end
function Runtime:register(model)
    assert(model:IsA("Model")and model.PrimaryPart and model:IsDescendantOf(self.config.RegistryRoot),"DEE_REGISTERED_MODEL_SCOPE")
    assert(Tags:HasTag(model,"DEE_Agent"),"DEE_AGENT_TAG_REQUIRED")
    local agentId=id(model:GetAttribute("DEE_AgentId"));assert(not self.agents[agentId],"DEE_DUPLICATE_AGENT_ID")
    local cfg=assert(self.config.Agents[agentId],"DEE_UNCONFIGURED_AGENT")
    local binding=Binding.resolve(cfg.Participant)
    assert(integer(cfg.MaxOpportunities)and cfg.MaxOpportunities&gt;0 and cfg.MaxOpportunities&lt;=1000,"DEE_FINITE_HORIZON")
    cfg=copy(cfg);cfg.MaxActions=cfg.MaxActions or cfg.MaxOpportunities*2
    assert(integer(cfg.MaxActions)and cfg.MaxActions&gt;0 and cfg.MaxActions&lt;=2000,"DEE_FINITE_ACTION_LEDGER")
    assert(not self.node:FindFirstChild(agentId),"DEE_EXISTING_RUNTIME_PRESERVED")
    local adapters=self.config.MakeAdapters(model,cfg)
    for _,name in ipairs({"body","sensors","world"})do assert(type(adapters[name])=="table","DEE_INJECTED_ADAPTER_REQUIRED")end
    local node=folder(self.node,agentId);node:SetAttribute("Protocol",M.Schema)
    local namespace=self.config.ExperienceId.."/"..self.config.SceneId.."/"..agentId
    node:SetAttribute("Namespace",namespace);node:SetAttribute("Participant",binding.mode)
    for _,name in ipairs({"State","Observation","ActionInbox","ActionAck","ToolAck"})do value(node,"StringValue",name,"")end
    for _,name in ipairs({"ActionCursor","OpportunityCursor","Sequence"})do value(node,"IntValue",name,0)end
    folder(node,"Actions");folder(node,"Tools")
    local a=setmetatable({runtime=self,namespace=namespace,node=node,config=cfg,binding=binding,adapters=adapters,busy=false,
        s={phase="PREPARED",sessionId="",lifeId="",nativeTick=0,sequence=0,actionCursor=0,completedOpportunities=0,closeRequested=false}},Agent)
    self.agents[agentId]=a;a:_save();return a
end
function Runtime:scanTagged()
    local candidates={}
    for _,model in ipairs(Tags:GetTagged("DEE_Agent"))do if model:IsDescendantOf(self.config.RegistryRoot)then table.insert(candidates,model)end end
    table.sort(candidates,function(a,b)return tostring(a:GetAttribute("DEE_AgentId"))&lt;tostring(b:GetAttribute("DEE_AgentId"))end)
    for _,model in ipairs(candidates)do if not self.agents[model:GetAttribute("DEE_AgentId")]then self:register(model)end end
    return self.agents
end
function Runtime:get(agentId)return assert(self.agents[agentId],"DEE_AGENT_NOT_REGISTERED")end
function Runtime:watchTagged()
    assert(not self.connections,"DEE_REGISTRY_ALREADY_WATCHING")
    self.connections={
        Tags:GetInstanceAddedSignal("DEE_Agent"):Connect(function(model)
            if model:IsDescendantOf(self.config.RegistryRoot)then
                local ok,err=pcall(self.register,self,model)
                if not ok then self.node:SetAttribute("RegistrationError",tostring(err))end
            end
        end),
        Tags:GetInstanceRemovedSignal("DEE_Agent"):Connect(function(model)
            local a=self.agents[model:GetAttribute("DEE_AgentId")]
            if a then a:requestClose()end -- preserve receipts, no cancellation/replay
        end),
    }
end
function Runtime:stopWatching()
    for _,connection in ipairs(self.connections or{})do connection:Disconnect()end
    self.connections=nil
end
function M.lookupRuntime(experienceId,sceneId)
    return assert(runtimes[id(experienceId).."/"..id(sceneId)],"DEE_RUNTIME_NOT_MOUNTED")
end
function M.mount(config)
    assert(Run:IsServer()and Run:IsStudio(),"DEE_LOCAL_STUDIO_SERVER_ONLY")
    id(config.ExperienceId);id(config.SceneId)
    assert(type(config.ScenarioFingerprint)=="string"and #config.ScenarioFingerprint==64,"DEE_SCENARIO_FINGERPRINT")
    assert(typeof(config.RegistryRoot)=="Instance"and type(config.MakeAdapters)=="function"and type(config.Agents)=="table","DEE_INJECTED_CONFIGURATION")
    local root=Storage:FindFirstChild("DEE_Runtime")
    if root then assert(root:IsA("Folder")and root:GetAttribute("Protocol")==M.Schema,"DEE_RUNTIME_CONFLICT")
    else root=folder(Storage,"DEE_Runtime");root:SetAttribute("Protocol",M.Schema)end
    local exp=root:FindFirstChild(config.ExperienceId)or folder(root,config.ExperienceId)
    assert(not exp:FindFirstChild(config.SceneId),"DEE_EXISTING_SCENE_RUNTIME_PRESERVED")
    local key=config.ExperienceId.."/"..config.SceneId
    assert(not runtimes[key],"DEE_RUNTIME_ALREADY_MOUNTED")
    local runtime=setmetatable({config=config,node=folder(exp,config.SceneId),agents={}},Runtime)
    runtimes[key]=runtime;return runtime
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_BackendBinding"><Properties><string name="Name">BackendBinding</string><ProtectedString name="Source">-- Transport bindings only; no policy, dictionary, arithmetic or Native world.
local B={}
local modes={DEE="LIVE_NATIVE",PROGRAMMED="PROGRAMMED",AI="CONVENTIONAL_AI"}
local origins={DEE="DEE_NATIVE",PROGRAMMED="PROGRAMMED",AI="CONVENTIONAL_AI"}
function B.resolve(name)
    assert(modes[name],"DEE_BACKEND_BINDING_UNKNOWN")
    return {participant=name,mode=modes[name],sourceKind=origins[name]}
end
return B
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_MinimalAdapters"><Properties><string name="Name">MinimalAdapters</string><ProtectedString name="Source">-- An explicit small scene adapter. Prepared kinematic offsets are actuators,
-- never choices or learned routes. No private goal or expected answer is read.
local A={}
local function pose(model)return {model:GetPivot():GetComponents()}end
function A.new(actor,options)
    assert(actor:IsA("Model")and actor.PrimaryPart,"DEE_MINIMAL_ACTOR")
    local root=assert(options.worldRoot,"DEE_WORLD_ROOT_REQUIRED")
    assert(actor:IsDescendantOf(root),"DEE_ACTOR_OUTSIDE_DECLARED_WORLD")
    local offsets=options.portOffsets or {[0]=Vector3.new(6,0,0),[1]=Vector3.new(-6,0,0)}
    local world={logicalTimeMs=0,contactCount=0}
    function world:capture()
        return {schema="DEE.MinimalWorld.v1",logicalTimeMs=self.logicalTimeMs,
            contactCount=self.contactCount,rng={algorithm="NONE"}}
    end
    function world:restore(state)
        assert(state.schema=="DEE.MinimalWorld.v1"and state.rng.algorithm=="NONE","DEE_MINIMAL_WORLD_SCHEMA")
        self.logicalTimeMs=state.logicalTimeMs;self.contactCount=state.contactCount
    end
    local body={}
    function body:execute(action)
        local before=pose(actor);local moved=false;local collision=false
        if action.name=="EXIT_0"or action.name=="EXIT_1"then
            local port=action.name=="EXIT_0"and 0 or 1
            local delta=assert(offsets[port],"DEE_UNAVAILABLE_PORT")
            if options.obstacleRoot then
                local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Include
                ray.FilterDescendantsInstances={options.obstacleRoot}
                collision=workspace:Blockcast(actor.PrimaryPart.CFrame,actor.PrimaryPart.Size*.9,delta,ray)~=nil
            end
            if not collision then actor:PivotTo(actor:GetPivot()+delta);moved=true end
        else
            assert(action.name=="ASK_STATION"or action.name=="SKIP_STATION"or action.name=="SAFE_WAIT","DEE_ACTION_NOT_SUPPORTED")
        end
        world.logicalTimeMs+=1
        return {outcome=collision and"BLOCKED"or moved and"MOVED"or"WAITED",moved=moved,
            collision=collision,before=before,after=pose(actor),worldTimeMs=world.logicalTimeMs,
            preparedKinematicActuator=true,noNativeExecutedByAdapter=true}
    end
    function body:capture()return {schema="DEE.MinimalBody.v1",pose=pose(actor)}end
    function body:restore(state)
        assert(state.schema=="DEE.MinimalBody.v1"and #state.pose==12,"DEE_BODY_STATE")
        actor:PivotTo(CFrame.new(table.unpack(state.pose)))
    end
    local sensors={}
    function sensors:observe(phase)
        local p=actor.PrimaryPart.Position
        return {phase=phase,sampleTimeMs=world.logicalTimeMs,
            sensors={position={p.X,p.Y,p.Z},contact=world.contactCount,
                availablePorts={0,1},source="LOCAL_MINIMAL_SCENE"}}
    end
    return {body=body,sensors=sensors,world=world}
end
return A
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_ExampleConfig"><Properties><string name="Name">ExampleConfig</string><ProtectedString name="Source">-- Public technical example. Not credentials, Native memories or a goal oracle.
return {
    ExperienceId="R06_CLEAN",SceneId="scene_01",Tag="DEE_Agent",
    Agents={agent_01={Participant="DEE",MaxOpportunities=2,MaxActions=4,
        AllowTechnicalTest=true}},
    transport="STUDIO_SERVER_MAILBOX",autostart=false,
    exampleScope="MCP_TECHNICAL_CONTROL_ONLY_NOT_A_NATIVE_EXPERIMENT",
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R07_PILOT_LiveAdapters_R07"><Properties><string name="Name">LiveAdapters_R07</string><ProtectedString name="Source">-- Another-map pilot: fixed sensors/ports and a geometry-only Humanoid motor.
-- No target selection, anti-loop, arithmetic, teacher or Native memory edit.
local Motor=require(script.Parent.MotorPathfinding_R07)
local A={}
local function pose(actor)return{actor:GetPivot():GetComponents()}end
function A.new(actor,o)
 local source=assert(o.inherited);local points=assert(o.points);local device=assert(o.device)
 local state={stock=source.permissionStock,worldTimeMs=0,signal=-1,
  inventoryKey=source.inventoryKey,inventoryResource=source.inventoryResource,
  numberAPresent=source.numberAPresent,codeBPresent=source.codeBPresent,codeBCurrent=source.codeBCurrent,
  numberAVersion=source.numberAVersion,lastFailure=false,queries=0,skips=0,moves=0,waits=0,
  sourceEnvironment=o.sourceEnvironment,rng={algorithm="NONE"},motorEvents={},contactCertain=true}
 local motor=Motor.new(actor,o.motor,function(kind,data)table.insert(state.motorEvents,{kind=kind,data=data})end,
  function(dt)state.worldTimeMs+=math.floor(dt*1000)end)
 local function contactCode()
  for code,p in pairs(points)do
   local d=motor.root.Position-p
   if Vector3.new(d.X,0,d.Z).Magnitude&lt;=o.motor.ArrivalRadius then return code end
  end
  error("R07_PILOT_PHYSICAL_CONTACT_UNKNOWN_NO_SENSOR_FABRICATED")
 end
 local world={}
 function world:capture()
  assert(not motor.active,"R07_PILOT_CAPTURE_NOT_MOVING")
  return{schema="DEE.R07.PilotWorld.R01",state=table.clone(state),
   device={value=device:GetAttribute("ActuatorValue"),canCollide=device.CanCollide,
    color={device.Color.R,device.Color.G,device.Color.B},transparency=device.Transparency},
   panels={price0=0,price1=0,signal=1},motor=motor:export(),
   declaredTask="TRANSFER_OF_CONNECTOR_TO_ANOTHER_MAP_NOT_FREE_MISSION_OR_NEW_LEARNING"}
 end
 function world:restore(saved)
  assert(saved.schema=="DEE.R07.PilotWorld.R01"and saved.state.rng.algorithm=="NONE","R07_PILOT_WORLD_SCHEMA")
  state=table.clone(saved.state);device:SetAttribute("ActuatorValue",saved.device.value)
  device.CanCollide=saved.device.canCollide;device.Transparency=saved.device.transparency
  device.Color=Color3.new(table.unpack(saved.device.color))
 end
 local body={}
 function body:execute(action)
  local started=os.clock();local r={before=pose(actor),collision=false,invalidAction=false,
   resourceCollected=false,resourceDelivered=false,permissionSpent=0,querySpent=0,tollSpent=0,
   outcome="WAITED",deviceBefore=device:GetAttribute("ActuatorValue")}
  if action.name=="ASK_STATION"then
   local code=contactCode();local panel=assert(o.panels[code])
   if state.stock&lt;1 or(panel.Position-motor.root.Position).Magnitude&gt;8 then
    r.invalidAction=true;r.outcome="QUERY_UNAVAILABLE"
   else
    assert(panel:GetAttribute("Signal")==1 and panel:GetAttribute("Price0")==0 and panel:GetAttribute("Price1")==0,"R07_PILOT_FIXED_PANEL")
    state.stock-=1;state.signal=1;state.queries+=1;r.permissionSpent=1;r.querySpent=1;r.outcome="PANEL_OBSERVED"
    task.wait(.1);state.worldTimeMs+=100
   end
  elseif action.name=="SKIP_STATION"then state.signal=-1;state.skips+=1;r.outcome="QUERY_OMITTED"
  elseif action.name=="SAFE_WAIT"then state.waits+=1;task.wait(.1);state.worldTimeMs+=100
  elseif action.name=="EXIT_0"or action.name=="EXIT_1"then
   local port=action.name=="EXIT_0"and 0 or 1
   -- Absolute endpoints are fixed actuator anatomy. The motor cannot substitute one.
   local result=motor:moveTo(points[port+1],action.actionId or"R07_PILOT_TRANSPORT")
   r.motor=result
   if result.status=="ARRIVED"then
    state.moves+=1;state.contactCertain=true;r.outcome="MOVED"
    device:SetAttribute("ActuatorValue",port);device.CanCollide=port==0
    device.Transparency=port==0 and .15 or .8
    device.Color=port==0 and Color3.fromRGB(220,150,70)or Color3.fromRGB(60,210,175)
    r.deviceActuation={port=port,value=device:GetAttribute("ActuatorValue"),actualCanCollide=device.CanCollide,
     semantic_choice_in_motor=false,prepared_fixed_actuator=true}
   else state.contactCertain=false;r.invalidAction=true;r.outcome="MOTOR_NO_PATH"end
   state.signal=-1
  else r.invalidAction=true;r.outcome="UNSUPPORTED_ACTION"end
  state.lastFailure=r.invalidAction or r.collision
  r.after=pose(actor);r.durationMs=math.floor((os.clock()-started)*1000);r.worldTimeMs=state.worldTimeMs
  r.deviceAfter=device:GetAttribute("ActuatorValue");r.materialConsequence=state.lastFailure
  r.preparedKinematicActuator=false;r.preparedHumanoidPathfinding=true
  return r
 end
 function body:capture()assert(not motor.active);return{schema="DEE.R07.PilotBody.R01",pose=pose(actor)}end
 function body:restore(saved)
  assert(saved.schema=="DEE.R07.PilotBody.R01"and not motor.active)
  actor:PivotTo(CFrame.new(table.unpack(saved.pose))) -- coherent restore only, never a motor waypoint.
 end
 local sensors={}
 function sensors:observe(phase)
  assert(state.contactCertain,"R07_PILOT_NO_NEW_EPISODE_AFTER_UNCERTAIN_PATH")
  if phase=="QUERY_CHOICE"then state.signal=-1 end
  local code=contactCode()
  return{phase=phase,worldTimeMs=state.worldTimeMs,sampleTimeMs=state.worldTimeMs,
   sensors={station=code,stage=state.inventoryResource and 2 or 1,contact=0,
    inventoryKey=state.inventoryKey,inventoryResource=state.inventoryResource,queryAvailable=state.stock&gt;=1,
    stationSignal=state.signal,permissionStock=state.stock,publicContactCode=code,lastFailure=state.lastFailure,
    numberAPresent=state.numberAPresent,codeBPresent=state.codeBPresent,numberAVersion=state.numberAVersion,
    codeBCurrent=state.codeBCurrent,goalDelivery=true}}
 end
 return{body=body,sensors=sensors,world=world}
end
return A
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R07_PILOT_MotorPathfinding_R07"><Properties><string name="Name">MotorPathfinding_R07</string><ProtectedString name="Source">-- Motor geometry only. The caller supplies ONE already selected destination.
-- No graph search for goals, inventory policy, novelty, anti-loop or target swap.
local PathfindingService=game:GetService("PathfindingService")
local RunService=game:GetService("RunService")
local Motor={};Motor.__index=Motor

local function part(parent,name,size,frame,color,collide)
    local p=parent:FindFirstChild(name)
    if p then assert(p:IsA("Part"),"R07_RIG_PART_CLASS");return p end
    p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=frame;p.Color=color
    p.Anchored=false;p.CanCollide=collide;p.CanTouch=true;p.CanQuery=true
    p:SetAttribute("R07PreparedBody",true);p.Parent=parent;return p
end
local function joint(parent,name,a,b,c0,c1)
    local old=parent:FindFirstChild(name)
    if old then assert(old:IsA("Motor6D"),"R07_JOINT_CLASS");return old end
    local m=Instance.new("Motor6D");m.Name=name;m.Part0=a;m.Part1=b
    m.C0=c0;m.C1=c1;m.Parent=parent;return m
end
function Motor.new(body,config,emit,onFrame)
    local self=setmetatable({},Motor)
    self.body=body;self.C=config;self.emit=emit;self.onFrame=onFrame;self.active=false
    local before=body:GetPivot();local existing={}
    for _,p in ipairs(body:GetDescendants())do if p:IsA("BasePart")then table.insert(existing,p)end end
    local root=part(body,"HumanoidRootPart",Vector3.new(2,2,1),before,Color3.fromRGB(70,205,230),false)
    root.Transparency=1;root.Anchored=true
    local torso=part(body,"Torso",Vector3.new(2,2,1),before,Color3.fromRGB(55,150,190),true)
    local head=part(body,"Head",Vector3.new(2,1,1),before*CFrame.new(0,1.5,0),Color3.fromRGB(130,225,225),false)
    local ll=part(body,"Left Leg",Vector3.new(1,2,1),before*CFrame.new(-.5,-2,0),Color3.fromRGB(55,90,130),true)
    local rl=part(body,"Right Leg",Vector3.new(1,2,1),before*CFrame.new(.5,-2,0),Color3.fromRGB(55,90,130),true)
    local la=part(body,"Left Arm",Vector3.new(1,2,1),before*CFrame.new(-1.5,0,0),Color3.fromRGB(75,175,200),false)
    local ra=part(body,"Right Arm",Vector3.new(1,2,1),before*CFrame.new(1.5,0,0),Color3.fromRGB(75,175,200),false)
    joint(root,"RootJoint",root,torso,CFrame.identity,CFrame.identity)
    joint(torso,"Neck",torso,head,CFrame.new(0,1,0),CFrame.new(0,-.5,0))
    joint(torso,"Left Hip",torso,ll,CFrame.new(-.5,-1,0),CFrame.new(0,1,0))
    joint(torso,"Right Hip",torso,rl,CFrame.new(.5,-1,0),CFrame.new(0,1,0))
    joint(torso,"Left Shoulder",torso,la,CFrame.new(-1.5,0,0),CFrame.identity)
    joint(torso,"Right Shoulder",torso,ra,CFrame.new(1.5,0,0),CFrame.identity)
    for _,p in ipairs(existing)do
        if p~=root and not p:GetAttribute("R07PreparedBody")then
            p.CanCollide=false;p.Massless=true
            if not p:FindFirstChild("R07OldVisualWeld")then
                local w=Instance.new("Weld");w.Name="R07OldVisualWeld";w.Part0=root;w.Part1=p
                w.C0=root.CFrame:ToObjectSpace(p.CFrame);w.C1=CFrame.identity;w.Parent=p
            end
        end
    end
    for _,p in ipairs(body:GetDescendants())do if p:IsA("BasePart")and p~=root then p.Anchored=false end end
    local h=body:FindFirstChildOfClass("Humanoid")or Instance.new("Humanoid")
    h.Name="Humanoid";h.RequiresNeck=false;h.BreakJointsOnDeath=false
    h.WalkSpeed=config.WalkSpeed;h.HipHeight=0;h.AutoRotate=true
    h.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;h.Parent=body
    body.PrimaryPart=root;self.root=root;self.humanoid=h
    root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
    self.emit("MOTOR_PREPARED",{kind="HUMANOID_PATHFINDING",preservedPivot={before:GetComponents()},
        semantic_destination_selected_by_motor=false})
    return self
end

function Motor:moveTo(destination,actionId)
    assert(not self.active and typeof(destination)=="Vector3","R07_SINGLE_FIXED_MOTOR_TARGET")
    self.active=true
    local selected=destination;local started=os.clock();local totalDistance=0;local old=self.root.Position
    local recomputes=0;local status="NO_PATH";local reason="NOT_COMPUTED";local pathRows={}
    self.emit("MOTOR_TARGET_ADMITTED",{actionId=actionId,selectedDestination={selected.X,selected.Y,selected.Z},
        walkSpeed=self.C.WalkSpeed,no_goal_substitution=true})
    while recomputes&lt;=self.C.MaxRecomputes and os.clock()-started&lt;self.C.MaxWallSeconds do
        local path=PathfindingService:CreatePath({AgentRadius=self.C.AgentRadius,AgentHeight=self.C.AgentHeight,
            AgentCanJump=self.C.AgentCanJump,AgentCanClimb=false,WaypointSpacing=self.C.WaypointSpacing})
        -- No semantic Costs/modifiers or desired goal can enter this service.
        local ok,err=pcall(function()path:ComputeAsync(self.root.Position,selected)end)
        if not ok or path.Status~=Enum.PathStatus.Success then reason=ok and"PATH_STATUS_NO_PATH"or tostring(err);break end
        local waypoints=path:GetWaypoints();local blocked=nil;local waypointIndex=1
        local connection=path.Blocked:Connect(function(index)if index&gt;=waypointIndex then blocked=index end end)
        self.root.Anchored=false;pcall(function()self.root:SetNetworkOwner(nil)end)
        local completed=true
        for index,waypoint in ipairs(waypoints)do
            waypointIndex=index
            if blocked or os.clock()-started&gt;=self.C.MaxWallSeconds then completed=false;reason="BLOCKED_OR_MOTOR_TIMEOUT";break end
            if waypoint.Action==Enum.PathWaypointAction.Jump then self.humanoid:ChangeState(Enum.HumanoidStateType.Jumping)end
            self.humanoid:MoveTo(waypoint.Position)
            local stepStart=os.clock();local reached=false
            while os.clock()-stepStart&lt;self.C.WaypointTimeout and os.clock()-started&lt;self.C.MaxWallSeconds do
                local dt=RunService.Heartbeat:Wait()
                totalDistance+=(self.root.Position-old).Magnitude;old=self.root.Position
                self.onFrame(dt)
                local delta=self.root.Position-waypoint.Position
                if Vector3.new(delta.X,0,delta.Z).Magnitude&lt;=self.C.ArrivalRadius then reached=true;break end
                if blocked then break end
            end
            table.insert(pathRows,{attempt=recomputes,waypoint=index,reached=reached,
                position={waypoint.Position.X,waypoint.Position.Y,waypoint.Position.Z}})
            if not reached then completed=false;reason=blocked and"PATH_BLOCKED"or"WAYPOINT_TIMEOUT";break end
        end
        connection:Disconnect()
        local delta=self.root.Position-selected
        if completed and Vector3.new(delta.X,0,delta.Z).Magnitude&lt;=self.C.ArrivalRadius then status="ARRIVED";reason="SELECTED_TARGET_REACHED";break end
        recomputes+=1
        -- Recompute only to selected, never a different station or useful tool.
    end
    self.humanoid:Move(Vector3.zero);self.root.Anchored=true
    self.root.AssemblyLinearVelocity=Vector3.zero;self.root.AssemblyAngularVelocity=Vector3.zero
    self.active=false
    local result={status=status,reason=reason,actionId=actionId,selectedDestination={selected.X,selected.Y,selected.Z},
        finalPosition={self.root.Position.X,self.root.Position.Y,self.root.Position.Z},recomputes=recomputes,
        wallSeconds=os.clock()-started,distance=totalDistance,waypoints=pathRows,no_alternate_goal=true}
    self.emit("MOTOR_RESULT",result);return result
end

function Motor:export()
    assert(not self.active and self.root.Anchored,"R07_NO_CAPTURE_DURING_MOTOR")
    return {schema="DEE.R07.prepared_motor.R01",active=false,rootAnchored=true,
        walkSpeed=self.humanoid.WalkSpeed,hipHeight=self.humanoid.HipHeight,
        autoRotate=self.humanoid.AutoRotate,parameters=self.C}
end
return Motor
</ProtectedString></Properties></Item></Item></roblox>