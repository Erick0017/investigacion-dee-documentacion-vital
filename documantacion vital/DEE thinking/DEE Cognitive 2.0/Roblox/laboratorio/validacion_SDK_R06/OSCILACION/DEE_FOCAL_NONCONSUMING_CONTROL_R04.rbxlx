</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_SDK_SDKBootstrap"><Properties><string name="Name">SDKBootstrap</string><ProtectedString name="Source">-- Construcción+registro. Este módulo nunca abre un backend ni emite una decisión.
local M={}
local H=game:GetService("HttpService")
local API=require(script.Parent.Main)
local Adapters=require(script.Parent.LiveAdapters_R07)
local DefaultMap=require(script.Parent.MapaEjemplo)
local function clone(v)return H:JSONDecode(H:JSONEncode(v))end
function M.prepare(cfg,contract)
 assert(game:GetService("RunService"):IsStudio()and game:GetService("RunService"):IsServer(),"SDK_STUDIO_SERVER_REQUIRED")
 assert(cfg.Version=="0.1.0"and(cfg.Mode=="PREVIEW"or cfg.Mode=="NATIVE"),"SDK_CONFIG_VERSION_MODE")
 local initial,participant,source
 if cfg.Mode=="NATIVE"then
  assert(type(contract)=="table"and type(contract.initialPublicState)=="table","SDK_NATIVE_CONTRACT_REQUIRED")
  initial=clone(contract.initialPublicState);source=assert(contract.sourceWorldSha256,"SDK_SOURCE_WORLD_REQUIRED");participant="DEE"
 else initial=clone(cfg.PreviewPublicState);source="PREVIEW_NOT_NATIVE_STATE";participant="PROGRAMMED"end
 local Map=cfg.MapModule and require(assert(script.Parent:FindFirstChild(cfg.MapModule),"SDK_MAP_MODULE_REQUIRED"))or DefaultMap
 local AdapterFactory=cfg.AdapterModule and require(assert(script.Parent:FindFirstChild(cfg.AdapterModule),"SDK_ADAPTER_MODULE_REQUIRED"))or Adapters
 local scene=Map.build(cfg)
 local runtime=API.mount({ExperienceId=cfg.ExperienceId,SceneId=cfg.SceneId,ScenarioFingerprint=cfg.ScenarioFingerprint,RegistryRoot=scene.world,Agents={[cfg.AgentId]={Participant=participant,MaxOpportunities=cfg.MaxOpportunities,MaxActions=cfg.MaxActions,AllowTechnicalTest=false}},MakeAdapters=function(model)
  return AdapterFactory.new(model,{worldRoot=scene.world,panels=scene.panels,device=scene.device,points=scene.points,inherited=initial,sourceEnvironment=source,motor=clone(cfg.Map.Motor)})
 end})
 runtime:scanTagged();local agent=runtime:get(cfg.AgentId)
 local state=Instance.new("StringValue");state.Name="SDK_STATUS";state.Value=cfg.Mode=="PREVIEW"and"PREVIEW_PREPARED_NO_NATIVE_K2_K3_PENDING"or"NATIVE_CONTRACT_PREPARED_NOT_YET_BOUND";state.Parent=scene.world
 scene.world:SetAttribute("Mode",cfg.Mode);scene.world:SetAttribute("NativeBackendOpenedByBootstrap",false)
 return{runtime=runtime,agent=agent,scene=scene,status=state}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_SDK_HttpTransport"><Properties><string name="Name">HttpTransport</string><ProtectedString name="Source">-- Revision TRANSPORT_R02: IDs already validated URL-unreserved; preserve literalpath/query.
-- HTTP local privado; sólo transporte/idempotencia. Nunca decide ni rePOSTea material.
local H=game:GetService("HttpService")
local Storage=game:GetService("ServerStorage")
local M={};local Client={};Client.__index=Client
local function id(v)assert(type(v)=="string"and #v&gt;0 and #v&lt;=160 and not string.find(v,"[^%w_%-%.]"),"SDK_IDENTIFIER");return v end
local function folder(parent,name)local n=parent:FindFirstChild(name);if n then assert(n:IsA("Folder"),"SDK_STORAGE_CONFLICT");return n end;n=Instance.new("Folder");n.Name=name;n.Parent=parent;return n end
local function text(parent,name)local n=parent:FindFirstChild(name);if n then assert(n:IsA("StringValue"),"SDK_STORAGE_CONFLICT");return n end;n=Instance.new("StringValue");n.Name=name;n.Value="";n.Parent=parent;return n end
local function childValue(parent,name)local v=parent and parent:FindFirstChild(name);assert(v and v:IsA("StringValue")and #v.Value&gt;0,"SDK_PRIVATE_CONNECTION_REQUIRED_"..name);return v.Value end
function M.readPrivateConnection(cfg)
 local p=Storage:FindFirstChild(cfg.PrivateConnectionFolder or"DEE_SDK_PrivateConnection")
 return{BaseUrl=childValue(p,"BaseUrl"),InstanceId=childValue(p,"InstanceId"),Token=childValue(p,"Token")}
end
function M.new(connection,cfg)
 local base=assert(connection.BaseUrl);assert(type(base)=="string"and not string.find(base,"@"),"SDK_ENDPOINT_NO_EMBEDDED_CREDENTIALS")
 assert(string.match(base,"^http://127%.0%.0%.1:%d+$")or string.match(base,"^http://localhost:%d+$"),"SDK_LOCAL_ENDPOINT_ONLY_0_1_0")
 local instance=id(connection.InstanceId);assert(type(connection.Token)=="string"and #connection.Token&gt;0,"SDK_PRIVATE_TOKEN_REQUIRED")
 local root=folder(Storage,"DEE_SDK_Transport");local node=folder(root,instance)
 local self=setmetatable({base=base,instanceId=instance,token=connection.Token,cfg=cfg,node=node,ledger=folder(node,"Operations"),status=text(node,"Status")},Client)
 self.status.Value="CLIENT_PREPARED_NO_NATIVE_REQUEST";return self
end
function Client:_request(method,path,body)
 local options={Url=self.base..path,Method=method,Headers={Authorization="Bearer "..self.token,["Content-Type"]="application/json"}}
 if body~=nil then options.Body=H:JSONEncode(body)end
 local reply=H:RequestAsync(options)
 local ok,decoded=pcall(function()return H:JSONDecode(reply.Body)end)
 assert(ok and type(decoded)=="table","SDK_HTTP_NON_JSON_PRESERVED")
 if not reply.Success or decoded.ok~=true then
  local code=type(decoded.error)=="table"and decoded.error.code or tostring(reply.StatusCode)
  error("SDK_HTTP_"..tostring(code),0)
 end
 assert(decoded.result~=nil,"SDK_HTTP_RESULT_REQUIRED");return decoded.result
end
function Client:handshake()return self:_request("GET","/v1/instances/"..id(self.instanceId).."/handshake")end
function Client:waitReadyHandshake()
 local started=os.clock();local limit=self.cfg.StartupWaitSeconds or 900
 assert(type(limit)=="number"and limit&gt;=1 and limit&lt;=3600,"SDK_FINITE_STARTUP_DEADLINE")
 while os.clock()-started&lt;limit do
  local contract=self:handshake()
  if contract.status=="READY"then self.status.Value="BACKEND_READY_NO_NATIVE_REQUEST";return contract end
  assert(contract.status=="STARTING","SDK_BACKEND_HANDSHAKE_STATE")
  self.status.Value="WAITING_BACKEND_READY_NO_NATIVE_REQUEST";task.wait(self.cfg.PollIntervalSeconds or 2)
 end
 error("SDK_BACKEND_STARTUP_DEADLINE_NO_NATIVE_REQUEST",0)
end
function Client:getStatus()return self:_request("GET","/v1/instances/"..id(self.instanceId).."/status")end
function Client:operationStatus(operationId)return self:_request("GET","/v1/operations/"..id(operationId).."?instanceId="..id(self.instanceId))end
function Client:newOperation(kind)return id("sdk_"..kind.."_"..H:GenerateGUID(false))end
function Client:_save(operationId,value)text(self.ledger,id(operationId)).Value=H:JSONEncode(value)end
function Client:_read(operationId)local n=self.ledger:FindFirstChild(operationId);return n and H:JSONDecode(n.Value)or nil end
function Client:assertQuiescent()
 for _,entry in ipairs(self.ledger:GetChildren())do
  local r=H:JSONDecode(entry.Value)
  assert(r.status=="ACKNOWLEDGED"or r.status=="COMMITTED"or r.status=="SEALED","SDK_EXISTING_OPERATION_REQUIRES_RECONCILIATION_"..entry.Name)
 end
end
function Client:waitOperation(operationId)
 local started=os.clock();local limit=self.cfg.OperationPollSeconds or 900;assert(type(limit)=="number"and limit&gt;=1 and limit&lt;=3600,"SDK_FINITE_POLL_DEADLINE")
 while os.clock()-started&lt;limit do
  local ok,r=pcall(function()return self:operationStatus(operationId)end)
  if ok then
   assert(r.operationId==operationId,"SDK_OPERATION_ID_MISMATCH")
   local saved=self:_read(operationId)or{operationId=operationId};saved.status=r.status;saved.value=r.value;saved.error=r.error;self:_save(operationId,saved)
   if r.status=="COMPLETED"then assert(r.value~=nil,"SDK_COMPLETED_WITHOUT_VALUE");self.status.Value="COMPLETED_"..operationId;return r.value end
   if r.status=="FAILED_KNOWN"or r.status=="UNCERTAIN"then self.status.Value=r.status.."_PRESERVED_"..operationId;error("SDK_OPERATION_"..r.status.."_PRESERVED",0)end
   assert(r.status=="PENDING"or r.status=="RUNNING","SDK_UNKNOWN_OPERATION_STATE")
  else self.status.Value="STATUS_READ_FAILED_PRESERVED_"..operationId end
  task.wait(self.cfg.PollIntervalSeconds or 2)
 end
 self.status.Value="POLL_DEADLINE_PRESERVED_"..operationId;error("SDK_OPERATION_DEADLINE_UNKNOWN_PRESERVED_"..operationId,0)
end
function Client:postOperation(path,body)
 local op=id(body.operationId);assert(self:_read(op)==nil,"SDK_OPERATION_ALREADY_RECORDED_NO_REPOST")
 assert(#self.ledger:GetChildren()&lt;(self.cfg.MaxOperationRecords or 128),"SDK_FINITE_OPERATION_LEDGER")
 self:_save(op,{operationId=op,status="POST_INTENT",path=path,body=body}) -- headers/token never stored
 self.status.Value="POST_INTENT_"..op
 local ok,r=pcall(function()return self:_request("POST",path,body)end)
 if ok then assert(r.operationId==op,"SDK_SUBMIT_OPERATION_ID")
 else self.status.Value="POST_UNKNOWN_PRESERVED_"..op end
 -- Even after a network/HTTP error only GET reconciliation is allowed here.
 return self:waitOperation(op)
end
function Client:postRecorded(path,body,finalStatus)
 local op=id(body.operationId);assert(self:_read(op)==nil,"SDK_OPERATION_ALREADY_RECORDED_NO_REPOST")
 self:_save(op,{operationId=op,status="POST_INTENT",path=path,body=body})
 local ok,r=pcall(function()return self:_request("POST",path,body)end)
 if not ok then self.status.Value="SYNC_POST_UNKNOWN_PRESERVED_"..op;error("SDK_SYNC_POST_UNKNOWN_PRESERVED_"..op,0)end
 self:_save(op,{operationId=op,status=finalStatus or"ACKNOWLEDGED",path=path,result=r});return r
end
function Client:mark(operationId,status)local r=assert(self:_read(operationId));r.status=status;self:_save(operationId,r)end
M.Client=Client;return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_SDK_HttpLoop"><Properties><string name="Name">HttpLoop</string><ProtectedString name="Source">-- Plomería de fases: jamás selecciona un puerto ni corrige una salidaNative.
local H=game:GetService("HttpService")
local Transport=require(script.Parent.HttpTransport)
local Bootstrap=require(script.Parent.SDKBootstrap)
local M={};local running={}
local allowed={ASK_STATION=true,SKIP_STATION=true,EXIT_0=true,EXIT_1=true,SAFE_WAIT=true}
local function copy(v)return H:JSONDecode(H:JSONEncode(v))end
local function setStatus(handle,value)handle.phase=value;handle.prepared.status.Value=value end
local function executeChoice(handle,kind,observation)
 local client=handle.client;local agent=handle.prepared.agent;local contract=handle.contract
 local op=client:newOperation(kind)
 setStatus(handle,"WAITING_NATIVE_"..string.upper(kind))
 local value=client:postOperation("/v1/native/"..kind,{instanceId=client.instanceId,operationId=op,sessionId=contract.sessionId,payload={observation=copy(observation)}})
 assert(type(value)=="table"and allowed[value.action]and type(value.nativeTick)=="number","SDK_UNSUPPORTED_NATIVE_RESULT_PRESERVED")
 assert(value.operation_id==nil or value.operation_id==op,"SDK_NATIVE_OPERATION_ID")
 local raw={protocol="DEE.RBX.Connector.R01",namespace=agent.namespace,sessionId=contract.sessionId,seq=observation.seq,observationId=observation.observationId,actionId=op,operationId=op,sourceKind="DEE_NATIVE",action={name=value.action,nativeTick=value.nativeTick,null=value.null,actionId=op}}
 setStatus(handle,"EXECUTING_NATIVE_"..value.action)
 local ack=agent:deliverAction(H:JSONEncode(raw))
 assert(ack.actionId==op and ack.operationId==op and ack.observationId==observation.observationId,"SDK_BODY_ACK_ID")
 local ackOp=client:newOperation("action_ack")
 local registered=client:postRecorded("/v1/action-ack",{instanceId=client.instanceId,operationId=ackOp,sessionId=contract.sessionId,actionId=op,observationId=observation.observationId,localSequence=observation.seq,ack=copy(ack)},"ACKNOWLEDGED")
 assert(registered.status=="ACKNOWLEDGED"and registered.actionId==op,"SDK_RUNTIME_ACK_REQUIRED")
 agent:confirmActionAck(op,op);client:mark(op,"ACKNOWLEDGED")
 return value,ack,op
end
local function cycle(handle)
 local agent=handle.prepared.agent;local client=handle.client;local contract=handle.contract
 assert(agent:status().phase=="BOUNDARY","SDK_BOUNDARY_BEFORE_CYCLE")
 local obs=agent:observe("QUERY_CHOICE");local choice,ack,actionId=executeChoice(handle,"decision",obs)
 local spent=assert(ack.result.permissionSpent,"SDK_COST_MEASUREMENT")
 if choice.action~="SAFE_WAIT"then
  obs=agent:observe("ROUTE_CHOICE");choice,ack,actionId=executeChoice(handle,"query_sensor",obs);spent+=assert(ack.result.permissionSpent)
 end
 assert(agent:toolRequest()==nil,"SDK_DEFAULT_MAP_TOOL_UNSUPPORTED_PRESERVED")
 local result=ack.result
 local payload={actionId=actionId,seq=obs.seq,observationId=obs.observationId,worldTimeMs=result.worldTimeMs,durationMs=result.durationMs,outcome=result.outcome,collision=result.collision,resourceCollected=result.resourceCollected,resourceDelivered=result.resourceDelivered,permissionSpent=spent,materialConsequence=result.materialConsequence,lastObservation=copy(obs)}
 local op=client:newOperation("feedback");setStatus(handle,"WAITING_NATIVE_FEEDBACK")
 local returned=client:postOperation("/v1/native/feedback",{instanceId=client.instanceId,operationId=op,sessionId=contract.sessionId,payload=payload})
 assert(type(returned)=="table"and returned.accepted==true,"SDK_FEEDBACK_NOT_ACCEPTED_PRESERVED")
 agent:completeFeedback({actionId=actionId,feedbackOperationId=op,nativeTick=returned.nativeTick});client:mark(op,"COMMITTED")
 setStatus(handle,"CYCLE_BOUNDARY_"..agent:status().completedOpportunities)
end
local function saveClose(handle)
 local agent=handle.prepared.agent;local client=handle.client;local contract=handle.contract
 assert(agent:status().phase=="BOUNDARY","SDK_CLOSE_BOUNDARY_ONLY");agent:requestClose();setStatus(handle,"WAITING_NATIVE_SAVE_CLOSE")
 local closeId=client:newOperation("close")
 local result=client:postOperation("/v1/session/close",{instanceId=client.instanceId,operationId=closeId,sessionId=contract.sessionId})
 local proof=assert(result.backendProof,"SDK_NATIVE_CLOSED_PROOF_REQUIRED")
 assert(proof.backendWriterClosed==true and proof.bridgeQuiescent==true,"SDK_NATIVE_NOT_CLOSED")
 local snapshot=agent:capture(proof);client:mark(closeId,"COMMITTED")
 local checkpointId=client:newOperation("checkpoint")
 local sealed=client:postRecorded("/v1/checkpoint",{instanceId=client.instanceId,operationId=checkpointId,sessionId=contract.sessionId,snapshot=snapshot},"SEALED")
 assert(sealed.status=="SEALED"and sealed.nativeTick==proof.nativeTick and type(sealed.checkpointSha256)=="string","SDK_CHECKPOINT_NOT_SEALED")
 handle.checkpoint=sealed;handle.closed=true;setStatus(handle,"CLOSED_SEALED_"..sealed.checkpointId)
end
function M.start(cfg)
 assert(cfg.Mode=="NATIVE","SDK_NATIVE_MODE_EXPLICIT_REQUIRED")
 local client=Transport.new(Transport.readPrivateConnection(cfg),cfg.Transport or{})
 assert(not running[client.instanceId],"SDK_INSTANCE_LOOP_ALREADY_EXISTS");client:assertQuiescent()
 local contract=client:waitReadyHandshake()
 assert(contract.instanceId==client.instanceId and contract.protocolVersion=="DEE.RBX.Connector.R01"and contract.runtimeVersion=="0.1.0","SDK_RUNTIME_CONTRACT_VERSION")
 assert(contract.backendKind=="NATIVE_REAL"and contract.technicalControl==false,"SDK_REAL_NATIVE_BACKEND_REQUIRED")
 local prepared=Bootstrap.prepare(cfg,contract);local agent=prepared.agent
 if contract.snapshot~=nil then
  assert(contract.backendProof~=nil and type(contract.checkpointSha256)=="string","SDK_PAIRED_RESTORE_PROOF_REQUIRED")
  local expected=copy(contract.backendProof);expected.checkpointSha256=contract.checkpointSha256
  agent:restore(contract.snapshot,expected) -- explicit continuation, no bindfresh or counter reset
 else
  assert(contract.localSequence==0,"SDK_NEW_WITH_NONZERO_CURSOR_REJECTED")
  agent:bindSession({sessionId=contract.sessionId,lifeId=contract.lifeId,nativeTick=contract.nativeTick})
 end
 assert(agent:status().sequence==contract.localSequence,"SDK_LOCAL_CURSOR_MISMATCH")
 local handle={client=client,contract=contract,prepared=prepared,closed=false};running[client.instanceId]=handle
 function handle:requestClose()self.requestedClose=true;return self.prepared.agent:status()end
 function handle:status()return{phase=self.phase,closed=self.closed,error=self.error,checkpoint=self.checkpoint,agent=self.prepared.agent:status()}end
 task.spawn(function()
  local ok,err=xpcall(function()
   local count=cfg.RunCycles or 1;assert(type(count)=="number"and count%1==0 and count&gt;=1 and count&lt;=cfg.MaxOpportunities,"SDK_FINITE_RUN_CYCLES")
   for _=1,count do
    local s=agent:status();if handle.requestedClose or s.closeRequested or s.completedOpportunities&gt;=cfg.MaxOpportunities then break end
    cycle(handle)
   end
   saveClose(handle)
  end,function(e)return tostring(e)end)
  if not ok then handle.error=err;setStatus(handle,"ERROR_PRESERVED_OWNER_RECONCILIATION_REQUIRED");warn("DEE_SDK: "..err)end
 end)
 return handle
end
function M.get(instanceId)return running[instanceId]end
return M
</ProtectedString></Properties></Item><Item class="Script" referent="RBX_SDK_SDK_Arranque"><Properties><string name="Name">SDK_Arranque</string><ProtectedString name="Source">-- Arranque visible del ejemplo. PREVIEW no emite acciones niabreNative.
local package=script.Parent
local cfg=require(package.SDKConfig)
if cfg.Mode=="PREVIEW"then
 local ok,err=pcall(function()require(package.SDKBootstrap).prepare(cfg,nil)end)
 if not ok then warn("DEE_SDK_PREVIEW: "..tostring(err))end
elseif cfg.Mode=="NATIVE"then
 local ok,err=pcall(function()require(package.FocalHttpLoop).start(cfg)end)
 if not ok then warn("DEE_SDK_NATIVE_PRESERVED: "..tostring(err))end
else error("SDK_MODE_MUST_BE_PREVIEW_OR_NATIVE")end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FOCAL_MapaFocal"><Properties><string name="Name">MapaFocal</string><ProtectedString name="Source">-- Anatomía fija de seis zonas R07. No selecciona puertos ni resuelve objetivos.
local H=game:GetService("HttpService")
local M={}
local function v(a)return Vector3.new(a[1],a[2],a[3])end
function M.build(cfg)
 local c=cfg.Map;assert(not workspace:FindFirstChild(c.RootName),"FOCAL_WORLD_EXISTS_PRESERVED")
 local w=Instance.new("Folder");w.Name=c.RootName;w:SetAttribute("FocalConfig",H:JSONEncode(cfg.Focal));w:SetAttribute("ScenarioFingerprint",cfg.ScenarioFingerprint);w.Parent=workspace
 local function part(parent,name,pos,size,collide)
  local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=collide;p.CanQuery=true;p.Size=v(size);p.Position=pos;p.Parent=parent;return p
 end
 local floor=part(w,"Suelo",Vector3.new(0,4.5,10),{220,1,220},true);floor.Color=Color3.fromRGB(45,55,70)
 for i,o in ipairs(c.Obstacles)do local p=part(w,"Obstaculo"..i,v(o.Position),o.Size,true);p.Color=Color3.fromRGB(100,115,130)end
 local markers=Instance.new("Folder");markers.Name="Markers";markers.Parent=w
 local gatesFolder=Instance.new("Folder");gatesFolder.Name="Gates";gatesFolder.Parent=w
 local points,panels={},{}
 for s=0,5 do
  local p=v(c.Positions[tostring(s)]);points[s]=p
  local marker=part(markers,"Contacto"..s,p,{9,8,9},false);marker.Transparency=.9;marker:SetAttribute("ContactCode",s)
  local panel=part(w,"Panel_"..s,p+Vector3.new(0,2,0),{3,1,1},false);panel.Color=Color3.fromRGB(90,180,240);panels[s]=panel
  for port=0,1 do
   local gate=part(gatesFolder,"Gate_"..s.."_"..port,p+Vector3.new(port==0 and -3 or 3,0,0),{2,3,1},false)
   gate:SetAttribute("Station",s);gate:SetAttribute("Port",port);gate:SetAttribute("FocalCapacity",1);gate.Color=Color3.fromRGB(80,210,170)
  end
 end
 local actor=Instance.new("Model");actor.Name="DEE_Focal";actor.Parent=w
 local root=part(actor,"CoreInicial",points[cfg.Focal.startStation],{2,2,1},false);actor.PrimaryPart=root
 actor:SetAttribute("DEE_AgentId",cfg.AgentId);game:GetService("CollectionService"):AddTag(actor,"DEE_Agent")
 local device=part(w,"UltimoPuertoObservado",Vector3.new(0,10,10),{2,2,2},false);device:SetAttribute("ActuatorValue",-1)
 return{world=w,actor=actor,points=points,panels=panels,device=device}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FOCAL_FocalAdapters"><Properties><string name="Name">FocalAdapters</string><ProtectedString name="Source">-- Sólo anatomía+sensores/consecuencias ambientales. Elección proviene de Native.
local H=game:GetService("HttpService")
local Motor=require(script.Parent.MotorPathfinding_R07)
local Availability=require(script.Parent.DisponibilidadLocal)
local A={}
local function clone(x)return H:JSONDecode(H:JSONEncode(x))end
local function pose(actor)return{actor:GetPivot():GetComponents()}end
function A.new(actor,o)
 local source=assert(o.inherited);local cfg=H:JSONDecode(assert(o.worldRoot:GetAttribute("FocalConfig")))
 assert(type(source.permissionStock)=="number"and source.permissionStock&gt;=cfg.minimumPermissionStock and source.permissionStock&lt;=200,"FOCAL_REAL_STOCK_AT_LEAST18_REQUIRED")
 local state={stock=source.permissionStock,worldTimeMs=0,signal=-1,station=cfg.startStation,epoch=0,
  inventoryKey=source.inventoryKey,inventoryResource=source.inventoryResource,numberAPresent=source.numberAPresent,
  codeBPresent=source.codeBPresent,codeBCurrent=source.codeBCurrent,numberAVersion=source.numberAVersion,
  lastFailure=false,queries=0,skips=0,moves=0,waits=0,tollSpent=0,freePassesUsed=0,
  sourceEnvironment=o.sourceEnvironment,contactCertain=true,motorEvents={},environmentEvents={}}
 local function emit(kind,data)table.insert(state.environmentEvents,{kind=kind,data=data})end
 local motor=Motor.new(actor,o.motor,function(kind,data)table.insert(state.motorEvents,{kind=kind,data=data})end,
  function(dt)state.worldTimeMs+=math.floor(dt*1000)end)
 local gates={};for s=0,5 do gates[s]={};for p=0,1 do gates[s][p]=assert(o.worldRoot.Gates:FindFirstChild("Gate_"..s.."_"..p))end end
 local law=Availability.new(gates,o.panels,cfg,emit)
 local function contactCode(required)
  local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={o.worldRoot.Markers}
  local found=nil
  for _,p in ipairs(workspace:GetPartsInPart(motor.root,params))do
   local tag=p:GetAttribute("ContactCode")
   if tag~=nil then assert(type(tag)=="number"and tag%1==0 and tag&gt;=0 and tag&lt;=5 and(found==nil or found==tag),"FOCAL_AMBIGUOUS_CONTACT");found=tag end
  end
  if required then assert(found~=nil,"FOCAL_NO_PHYSICAL_CONTACT_PRESERVED")end
  return found
 end
 local world={}
 function world:capture()
  assert(not motor.active,"FOCAL_NO_CAPTURE_DURING_ACTION")
  return{schema="DEE.Focal.World.R02",state=clone(state),availability=law:capture(),motor=motor:export(),
   device={value=o.device:GetAttribute("ActuatorValue"),canCollide=o.device.CanCollide,color={o.device.Color.R,o.device.Color.G,o.device.Color.B},transparency=o.device.Transparency},
   scope="Focal six-zone apparatus only; paired full Native required separately"}
 end
 function world:restore(saved)
  assert(saved.schema=="DEE.Focal.World.R02"and not motor.active,"FOCAL_WORLD_RESTORE")
  state=clone(saved.state);law:restore(saved.availability)
  o.device:SetAttribute("ActuatorValue",saved.device.value);o.device.CanCollide=saved.device.canCollide
  o.device.Color=Color3.new(table.unpack(saved.device.color));o.device.Transparency=saved.device.transparency
 end
 local body={}
 function body:execute(action)
  local started=os.clock();local r={before=pose(actor),collision=false,invalidAction=false,resourceCollected=false,resourceDelivered=false,
   permissionSpent=0,querySpent=0,tollSpent=0,outcome="WAITED",deviceBefore=o.device:GetAttribute("ActuatorValue")}
  local station=contactCode(true);assert(station==state.station,"FOCAL_STATION_PHYSICAL_MISMATCH")
  if action.name=="ASK_STATION"then
   if state.stock&lt;1 then r.invalidAction=true;r.outcome="QUERY_UNAVAILABLE"
   else
    local sample=law:quoteLocal(station,motor.root);state.stock-=1;state.signal=sample.signal;state.queries+=1
    r.permissionSpent=1;r.querySpent=1;r.outcome="PANEL_OBSERVED";r.panelAudit=sample
    emit("PAID_LOCAL_PANEL",{actionId=action.actionId,station=station,epoch=state.epoch,sample=sample})
   end
   task.wait(.1);state.worldTimeMs+=100
  elseif action.name=="SKIP_STATION"then state.signal=-1;state.skips+=1;r.outcome="QUERY_OMITTED"
  elseif action.name=="SAFE_WAIT"then state.waits+=1;task.wait(.1);state.worldTimeMs+=100
  elseif action.name=="EXIT_0"or action.name=="EXIT_1"then
   local port=action.name=="EXIT_0"and 0 or 1;local target=assert(cfg.edges[tostring(station)][tostring(port)])
   local price=gates[station][port]:GetAttribute("TollCost_C02");assert(price==0 or price==2,"FOCAL_PHYSICAL_PRICE")
   assert((gates[station][port].Position-motor.root.Position).Magnitude&lt;=12,"FOCAL_SELECTED_GATE_NOT_LOCAL")
   r.selectedPort=port;r.originStation=station;r.selectedTarget=target
   if state.stock&lt;price then r.invalidAction=true;r.outcome="DEVICE_BLOCKED"
   else
    state.stock-=price;state.tollSpent+=price;r.permissionSpent=price;r.tollSpent=price
    emit("PORT_ATTEMPT_TOLL",{actionId=action.actionId,station=station,port=port,target=target,price=price})
    local moved=motor:moveTo(o.points[target],action.actionId);r.motor=moved
    if moved.status=="ARRIVED"then
     assert(contactCode(true)==target,"FOCAL_ARRIVAL_CONTACT_MISMATCH_PRESERVED")
     local passage=law:recordVerifiedPassage(station,port,action.actionId,true)
     if passage.freePassUsed then state.freePassesUsed+=1 end
     state.station=target;state.moves+=1;state.contactCertain=true;r.outcome="MOVED";r.passage=passage
     o.device:SetAttribute("ActuatorValue",port);o.device.CanCollide=port==0
     o.device.Color=port==0 and Color3.fromRGB(220,150,70)or Color3.fromRGB(60,210,175)
    else
     r.invalidAction=true;r.outcome="MOTOR_NO_PATH";state.contactCertain=contactCode(false)==station
    end
   end
   state.signal=-1
  else r.invalidAction=true;r.outcome="UNSUPPORTED_ACTION"end
  state.lastFailure=r.invalidAction or r.collision;r.materialConsequence=state.lastFailure
  r.after=pose(actor);r.durationMs=math.floor((os.clock()-started)*1000);r.worldTimeMs=state.worldTimeMs
  r.deviceAfter=o.device:GetAttribute("ActuatorValue");emit("ACTION_EXECUTED",{actionId=action.actionId,name=action.name,result=r})
  return r
 end
 function body:capture()assert(not motor.active);return{schema="DEE.Focal.Body.R02",pose=pose(actor)}end
 function body:restore(saved)assert(saved.schema=="DEE.Focal.Body.R02"and not motor.active);actor:PivotTo(CFrame.new(table.unpack(saved.pose)))end
 local sensors={}
 function sensors:observe(phase)
  assert(state.contactCertain,"FOCAL_UNCERTAIN_CONTACT_NO_NEW_OBSERVATION")
  local station=contactCode(true);assert(station==state.station,"FOCAL_ACTUAL_STATION_ONLY")
  if phase=="QUERY_CHOICE"then state.epoch+=1;law:beginEpoch(state.epoch);state.signal=-1 end
  return{phase=phase,worldTimeMs=state.worldTimeMs,sampleTimeMs=state.worldTimeMs,
   sensors={station=station,stage=state.inventoryResource and 2 or 1,contact=0,
    inventoryKey=state.inventoryKey,inventoryResource=state.inventoryResource,queryAvailable=state.stock&gt;=1,
    stationSignal=state.signal,permissionStock=state.stock,publicContactCode=station,lastFailure=state.lastFailure,
    numberAPresent=state.numberAPresent,codeBPresent=state.codeBPresent,numberAVersion=state.numberAVersion,
    codeBCurrent=state.codeBCurrent,goalDelivery=true}}
 end
 return{body=body,sensors=sensors,world=world}
end
return A
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FOCAL_DisponibilidadLocal"><Properties><string name="Name">DisponibilidadLocal</string><ProtectedString name="Source">-- Candidato focal aislado. Sólo disponibilidad física local; no Native ni selección de salida.
-- No se instala en KIT_DESARROLLADOR ni modifica el adapter aprobado.
local M={};local Law={};Law.__index=Law
local function checkPort(station,port)assert(type(station)=="number"and station%1==0 and station&gt;=0 and station&lt;=5 and(port==0 or port==1),"FOCAL_PORT")end
function M.new(gates,panels,cfg,emit)
 assert(cfg.rechargeEpochs==3 and cfg.capacityPerPort==1 and cfg.emptyPortToll==2 and cfg.maxCyclesPerArm==6,"FOCAL_FROZEN_LAW")
 assert(cfg.Arm=="CONSUME_RECHARGE"or cfg.Arm=="NONCONSUMING_CONTROL","FOCAL_ARM")
 local self=setmetatable({gates=gates,panels=panels,cfg=cfg,epoch=0,ports={},actions={},emit=emit or function()end},Law)
 for s=0,5 do
  assert(panels[s]and panels[s]:IsA("BasePart"),"FOCAL_PHYSICAL_PANEL_REQUIRED")
  self.ports[s]={}
  for p=0,1 do assert(gates[s]and gates[s][p]and gates[s][p]:IsA("BasePart"),"FOCAL_PHYSICAL_GATE_REQUIRED");self.ports[s][p]={available=true,rechargeAt=nil}end
 end
 self:_publish();return self
end
function Law:_publish()
 for s=0,5 do
  local costs={}
  for p=0,1 do
   local token=self.ports[s][p];local gate=self.gates[s][p]
   costs[p]=token.available and 0 or self.cfg.emptyPortToll
   gate:SetAttribute("FocalPassAvailable",token.available);gate:SetAttribute("FocalRechargeAt",token.rechargeAt)
   gate:SetAttribute("TollCost_C02",costs[p])
  end
  local panel=self.panels[s];local signal=nil
  if costs[0]==0 then signal=costs[1]==0 and 1 or 0 elseif costs[1]==0 then signal=2 end
  panel:SetAttribute("Price0_C02",costs[0]);panel:SetAttribute("Price1_C02",costs[1]);panel:SetAttribute("EncodedSignal_C02",signal)
  panel:SetAttribute("FocalPanelReadable",signal~=nil)
 end
end
function Law:beginEpoch(epoch)
 assert(epoch==self.epoch+1 and epoch&lt;=6,"FOCAL_EXACT_FINITE_EPOCH");self.epoch=epoch
 for s=0,5 do for p=0,1 do local v=self.ports[s][p]
  if not v.available and epoch&gt;=v.rechargeAt then v.available=true;v.rechargeAt=nil;self.emit("FOCAL_PASS_REPLENISHED",{station=s,port=p,epoch=epoch})end
 end end
 self:_publish()
end
function Law:quoteLocal(station,root)
 checkPort(station,0);assert(root and root:IsA("BasePart"),"FOCAL_REAL_BODY_REQUIRED")
 local panel=self.panels[station]
 assert((panel.Position-root.Position).Magnitude&lt;=12,"FOCAL_PANEL_NOT_LOCAL")
 assert(panel:GetAttribute("FocalPanelReadable")==true,"FOCAL_BOTH_PAID_UNENCODABLE_STOP_BEFORE_NATIVE")
 return {signal=panel:GetAttribute("EncodedSignal_C02"),price0=panel:GetAttribute("Price0_C02"),price1=panel:GetAttribute("Price1_C02"),epoch=self.epoch}
end
function Law:recordVerifiedPassage(station,port,actionId,arrivalVerified)
 checkPort(station,port);assert(arrivalVerified==true and type(actionId)=="string"and #actionId&gt;0,"FOCAL_ACTUAL_PASSAGE_ONLY")
 assert(self.actions[actionId]==nil,"FOCAL_ACTION_ALREADY_RECORDED_NO_REPLAY");self.actions[actionId]=true
 local v=self.ports[station][port];local used=v.available
 if used and self.cfg.Arm=="CONSUME_RECHARGE"then v.available=false;v.rechargeAt=self.epoch+3 end
 self.emit("FOCAL_PASSAGE",{actionId=actionId,station=station,port=port,epoch=self.epoch,freePassUsed=used,arm=self.cfg.Arm,rechargeAt=v.rechargeAt})
 self:_publish();return {freePassUsed=used,rechargeAt=v.rechargeAt}
end
function Law:capture()
 local rows={}
 for s=0,5 do for p=0,1 do local v=self.ports[s][p];table.insert(rows,{station=s,port=p,available=v.available,rechargeAt=v.rechargeAt})end end
 return{schema="DEE.Focal.LocalAvailability.R02",arm=self.cfg.Arm,epoch=self.epoch,ports=rows,actions=table.clone(self.actions)}
end
function Law:restore(saved)
 assert(saved.schema=="DEE.Focal.LocalAvailability.R02"and saved.arm==self.cfg.Arm and type(saved.epoch)=="number"and saved.epoch%1==0 and saved.epoch&gt;=0 and saved.epoch&lt;=6,"FOCAL_RESTORE_IDENTITY")
 assert(type(saved.ports)=="table"and #saved.ports==12 and type(saved.actions)=="table","FOCAL_RESTORE_COMPLETE")
 local ports={};for s=0,5 do ports[s]={}end
 for _,row in ipairs(saved.ports)do
  checkPort(row.station,row.port);assert(ports[row.station][row.port]==nil and type(row.available)=="boolean","FOCAL_RESTORE_PORT")
  if row.available then assert(row.rechargeAt==nil,"FOCAL_RESTORE_READY")else assert(type(row.rechargeAt)=="number"and row.rechargeAt&gt;saved.epoch,"FOCAL_RESTORE_DEADLINE")end
  ports[row.station][row.port]={available=row.available,rechargeAt=row.rechargeAt}
 end
 for id,value in pairs(saved.actions)do assert(type(id)=="string"and value==true,"FOCAL_RESTORE_RECEIPT")end
 self.ports=ports;self.epoch=saved.epoch;self.actions=table.clone(saved.actions);self:_publish()
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FOCAL_HttpLoop"><Properties><string name="Name">FocalHttpLoop</string><ProtectedString name="Source">-- Guarda de enlaceFOCAL antes de cualquierPOST; no decide acciones ni cambiaDTOs.
local Transport=require(script.Parent.HttpTransport)
local OriginalLoop=require(script.Parent.HttpLoop)
local M={}
function M.start(cfg)
 assert(cfg.Mode=="NATIVE"and cfg.MaxOpportunities==6 and cfg.RunCycles==6 and cfg.MaxActions==12,"FOCAL_FIXED_6_12_HORIZON")
 local expected={CONSUME_RECHARGE="OSCILANTE",NONCONSUMING_CONTROL="CONTROL"}
 local condition=assert(expected[cfg.Focal.Arm],"FOCAL_SCENE_ARM")
 local client=Transport.new(Transport.readPrivateConnection(cfg),cfg.Transport or{})
 client:assertQuiescent()
 local contract=client:waitReadyHandshake() -- GET only, no Native request/phase advancement
 assert(contract.profile=="FOCAL","FOCAL_PROFILE_REQUIRED_NOT_DEMO3")
 assert(contract.focalCondition==condition,"FOCAL_BACKEND_SCENE_CONDITION_MISMATCH")
 assert(contract.sequenceOffset==56 and type(contract.localSequence)=="number"and contract.localSequence&gt;=0 and contract.localSequence&lt;=12,"FOCAL_CURSOR_CONTRACT")
 -- OriginalLoop does exact pairedNEW/CONTINUE checks and retains every original ID.
 return OriginalLoop.start(cfg)
end
return M
</ProtectedString></Properties></Item></Item></Item><Item class="ServerStorage" referent="RBX_CLEAN_STORAGE"><Properties><string name="Name">ServerStorage</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX_CLEAN_REPLICATED"><Properties><string name="Name">ReplicatedStorage</string></Properties></Item></roblox>