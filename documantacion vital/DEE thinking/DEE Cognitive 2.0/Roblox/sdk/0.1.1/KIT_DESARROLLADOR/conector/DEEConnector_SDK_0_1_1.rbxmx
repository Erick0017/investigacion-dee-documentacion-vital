</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_MapaEjemplo"><Properties><string name="Name">MapaEjemplo</string><ProtectedString name="Source">-- Aparato geométrico únicamente. No elige rutas ni abre Native.
local M={}
local function v(a) assert(type(a)=="table"and #a==3,"SDK_VECTOR3");return Vector3.new(a[1],a[2],a[3])end
function M.build(cfg)
 local c=cfg.Map;assert(not workspace:FindFirstChild(c.RootName),"SDK_SCENE_EXISTS_PRESERVED")
 local world=Instance.new("Folder");world.Name=c.RootName;world:SetAttribute("DEE_SDK_Version",cfg.Version);world:SetAttribute("ScenarioFingerprint",cfg.ScenarioFingerprint);world.Parent=workspace
 local function part(name,pos,size,parent,collide)
  local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=collide;p.CanQuery=true;p.Size=v(size);p.Position=v(pos);p.Parent=parent or world;return p
 end
 local points={[0]=v(c.Start),[1]=v(c.Port0),[2]=v(c.Port1)}
 local floor=part("Suelo",c.FloorCenter,c.FloorSize,world,true);floor.Color=Color3.fromRGB(45,55,70)
 local obstacles=Instance.new("Folder");obstacles.Name="Obstaculos";obstacles.Parent=world
 for i,o in ipairs(c.Obstacles)do local p=part("Obstaculo"..i,o.Position,o.Size,obstacles,true);p.Color=Color3.fromRGB(105,115,130)end
 local panels={}
 for code,p in pairs(points)do
  local panel=part("PanelLocal"..code,{p.X,p.Y+2,p.Z},{3,1,1},world,false);panel:SetAttribute("Signal",c.Panel.Signal);panel:SetAttribute("Price0",c.Panel.Price0);panel:SetAttribute("Price1",c.Panel.Price1);panel.Color=Color3.fromRGB(80,170,240);panels[code]=panel
  local mark=part("PuertoFijo"..code,{p.X,p.Y-2.8,p.Z},{7,.2,7},world,false);mark.Color=Color3.fromRGB(80,205,190)
 end
 local device=part("Dispositivo",c.Device,{5,6,1},world,false);device:SetAttribute("ActuatorValue",-1);device.Color=Color3.fromRGB(150,160,175)
 local actor=Instance.new("Model");actor.Name="DEE_Demo";actor.Parent=world
 local root=part("CoreInicial",c.Start,{2,2,1},actor,false);actor.PrimaryPart=root;actor:SetAttribute("DEE_AgentId",cfg.AgentId);game:GetService("CollectionService"):AddTag(actor,"DEE_Agent")
 return{world=world,actor=actor,points=points,panels=panels,device=device}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_SDKBootstrap"><Properties><string name="Name">SDKBootstrap</string><ProtectedString name="Source">-- Construcción+registro. Este módulo nunca abre un backend ni emite una decisión.
local M={}
local H=game:GetService("HttpService")
local API=require(script.Parent.Main)
local Adapters=require(script.Parent.LiveAdapters_R06)
local DefaultMap=require(script.Parent.MapaEjemplo)
local function clone(v)return H:JSONDecode(H:JSONEncode(v))end
function M.prepare(cfg,contract)
 assert(game:GetService("RunService"):IsStudio()and game:GetService("RunService"):IsServer(),"SDK_STUDIO_SERVER_REQUIRED")
 assert(cfg.Version=="0.1.1"and(cfg.Mode=="PREVIEW"or cfg.Mode=="NATIVE"),"SDK_CONFIG_VERSION_MODE")
 local initial,participant,source
 if cfg.Mode=="NATIVE"then
  assert(type(contract)=="table"and type(contract.initialPublicState)=="table","SDK_NATIVE_CONTRACT_REQUIRED")
  initial=clone(contract.initialPublicState);source=assert(contract.sourceWorldSha256,"SDK_SOURCE_WORLD_REQUIRED");participant="DEE"
 else initial=clone(cfg.PreviewPublicState);source="PREVIEW_NOT_NATIVE_STATE";participant="PROGRAMMED"end
 local Map=cfg.MapModule and require(assert(script.Parent:FindFirstChild(cfg.MapModule),"SDK_MAP_MODULE_REQUIRED"))or DefaultMap
 local AdapterFactory=cfg.AdapterModule and require(assert(script.Parent:FindFirstChild(cfg.AdapterModule),"SDK_ADAPTER_MODULE_REQUIRED"))or Adapters
 local scene=Map.build(cfg)
 local runtime=API.mount({ExperienceId=cfg.ExperienceId,SceneId=cfg.SceneId,ScenarioFingerprint=cfg.ScenarioFingerprint,PersistenceBinding=clone(assert(cfg.PersistenceBinding,"R06_BINDING_CONFIG_REQUIRED")),RegistryRoot=scene.world,Agents={[cfg.AgentId]={Participant=participant,MaxOpportunities=cfg.MaxOpportunities,MaxActions=cfg.MaxActions,AllowTechnicalTest=false}},MakeAdapters=function(model)
  return AdapterFactory.new(model,{worldRoot=scene.world,panels=scene.panels,device=scene.device,points=scene.points,inherited=initial,sourceEnvironment=source,motor=clone(cfg.Map.Motor)})
 end})
 runtime:scanTagged();local agent=runtime:get(cfg.AgentId)
 local state=Instance.new("StringValue");state.Name="SDK_STATUS";state.Value=cfg.Mode=="PREVIEW"and"PREVIEW_PREPARED_NO_NATIVE_K2_K3_PENDING"or"NATIVE_CONTRACT_PREPARED_NOT_YET_BOUND";state.Parent=scene.world
 scene.world:SetAttribute("Mode",cfg.Mode);scene.world:SetAttribute("NativeBackendOpenedByBootstrap",false)
 return{runtime=runtime,agent=agent,scene=scene,status=state}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_HttpTransport"><Properties><string name="Name">HttpTransport</string><ProtectedString name="Source">-- R06 keeps literal unreservedIDs and adds boundedresourcewait.
-- Revision TRANSPORT_R02: IDs already validated URL-unreserved; preserve literalpath/query.
-- HTTP local privado; sólo transporte/idempotencia. Nunca decide ni rePOSTea material.
local H=game:GetService("HttpService")
local Storage=game:GetService("ServerStorage")
local M={};local Client={};Client.__index=Client
local function id(v)assert(type(v)=="string"and #v&gt;0 and #v&lt;=160 and not string.find(v,"[^%w_%-%.]"),"SDK_IDENTIFIER");return v end
local function folder(parent,name)local n=parent:FindFirstChild(name);if n then assert(n:IsA("Folder"),"SDK_STORAGE_CONFLICT");return n end;n=Instance.new("Folder");n.Name=name;n.Parent=parent;return n end
local function text(parent,name)local n=parent:FindFirstChild(name);if n then assert(n:IsA("StringValue"),"SDK_STORAGE_CONFLICT");return n end;n=Instance.new("StringValue");n.Name=name;n.Value="";n.Parent=parent;return n end
local function childValue(parent,name)local v=parent and parent:FindFirstChild(name);assert(v and v:IsA("StringValue")and #v.Value&gt;0,"SDK_PRIVATE_CONNECTION_REQUIRED_"..name);return v.Value end
function M.readPrivateConnection(cfg)
 local p=Storage:FindFirstChild(cfg.PrivateConnectionFolder or"DEE_SDK_PrivateConnection")
 return{BaseUrl=childValue(p,"BaseUrl"),InstanceId=childValue(p,"InstanceId"),Token=childValue(p,"Token")}
end
function M.new(connection,cfg)
 local base=assert(connection.BaseUrl);assert(type(base)=="string"and not string.find(base,"@"),"SDK_ENDPOINT_NO_EMBEDDED_CREDENTIALS")
 assert(string.match(base,"^http://127%.0%.0%.1:%d+$")or string.match(base,"^http://localhost:%d+$"),"SDK_LOCAL_ENDPOINT_ONLY_0_1_0")
 local instance=id(connection.InstanceId);assert(type(connection.Token)=="string"and #connection.Token&gt;0,"SDK_PRIVATE_TOKEN_REQUIRED")
 local root=folder(Storage,"DEE_SDK_Transport");local node=folder(root,instance)
 local self=setmetatable({base=base,instanceId=instance,token=connection.Token,cfg=cfg,node=node,ledger=folder(node,"Operations"),status=text(node,"Status")},Client)
 self.status.Value="CLIENT_PREPARED_NO_NATIVE_REQUEST";return self
end
function Client:_request(method,path,body)
 local options={Url=self.base..path,Method=method,Headers={Authorization="Bearer "..self.token,["Content-Type"]="application/json"}}
 if body~=nil then options.Body=H:JSONEncode(body)end
 local reply=H:RequestAsync(options)
 local ok,decoded=pcall(function()return H:JSONDecode(reply.Body)end)
 assert(ok and type(decoded)=="table","SDK_HTTP_NON_JSON_PRESERVED")
 if not reply.Success or decoded.ok~=true then
  local code=type(decoded.error)=="table"and decoded.error.code or tostring(reply.StatusCode)
  error("SDK_HTTP_"..tostring(code),0)
 end
 assert(decoded.result~=nil,"SDK_HTTP_RESULT_REQUIRED");return decoded.result
end
function Client:setWindow(contract)
 assert(type(contract.lastNewUtcEpoch)=="number"and type(contract.hardFinishUtcEpoch)=="number"and contract.lastNewUtcEpoch&lt;contract.hardFinishUtcEpoch,"R06_FINITE_BACKEND_WINDOW_REQUIRED")
 self.lastNewUtcEpoch=contract.lastNewUtcEpoch;self.hardFinishUtcEpoch=contract.hardFinishUtcEpoch
end
function Client:pastHardDeadline()return self.hardFinishUtcEpoch~=nil and os.time()&gt;=self.hardFinishUtcEpoch end
function Client:handshake()return self:_request("GET","/v1/instances/"..id(self.instanceId).."/handshake")end
function Client:waitReadyHandshake()
 local started=os.clock();local limit=self.cfg.StartupWaitSeconds or 900
 assert(type(limit)=="number"and limit&gt;=1 and limit&lt;=3600,"SDK_FINITE_STARTUP_DEADLINE")
 while os.clock()-started&lt;limit do
  local contract=self:handshake();self:setWindow(contract)
  assert(not self:pastHardDeadline(),"R06_BACKEND_HARD_DEADLINE")
  if contract.status=="READY"then self.status.Value="BACKEND_READY_NO_NATIVE_REQUEST";return contract end
  assert(contract.status=="STARTING"or contract.status=="PENDING_RESOURCE","SDK_BACKEND_HANDSHAKE_STATE")
  self.status.Value="WAITING_BACKEND_READY_NO_NATIVE_REQUEST";task.wait(self.cfg.PollIntervalSeconds or 2)
 end
 error("SDK_BACKEND_STARTUP_DEADLINE_NO_NATIVE_REQUEST",0)
end
function Client:getStatus()return self:_request("GET","/v1/instances/"..id(self.instanceId).."/status")end
function Client:operationStatus(operationId)return self:_request("GET","/v1/operations/"..id(operationId).."?instanceId="..id(self.instanceId))end
function Client:newOperation(kind)return id("sdk_"..kind.."_"..H:GenerateGUID(false))end
function Client:_save(operationId,value)text(self.ledger,id(operationId)).Value=H:JSONEncode(value)end
function Client:_read(operationId)local n=self.ledger:FindFirstChild(operationId);return n and H:JSONDecode(n.Value)or nil end
function Client:assertQuiescent()
 for _,entry in ipairs(self.ledger:GetChildren())do
  local r=H:JSONDecode(entry.Value)
  assert(r.status=="ACKNOWLEDGED"or r.status=="COMMITTED"or r.status=="SEALED","SDK_EXISTING_OPERATION_REQUIRES_RECONCILIATION_"..entry.Name)
 end
end
function Client:waitOperation(operationId)
 local started=os.clock();local limit=self.cfg.OperationPollSeconds or 900;assert(type(limit)=="number"and limit&gt;=1 and limit&lt;=3600,"SDK_FINITE_POLL_DEADLINE")
 while os.clock()-started&lt;limit and not self:pastHardDeadline()do
  local ok,r=pcall(function()return self:operationStatus(operationId)end)
  if ok then
   assert(r.operationId==operationId,"SDK_OPERATION_ID_MISMATCH")
   local saved=self:_read(operationId)or{operationId=operationId};saved.status=r.status;saved.value=r.value;saved.error=r.error;saved.preNativeAdmissionGuaranteed=r.preNativeAdmissionGuaranteed;saved.nativeAdmissionStarted=r.nativeAdmissionStarted;self:_save(operationId,saved)
   if r.status=="COMPLETED"then assert(r.value~=nil,"SDK_COMPLETED_WITHOUT_VALUE");self.status.Value="COMPLETED_"..operationId;return r.value end
   if r.status=="FAILED_KNOWN"or r.status=="UNCERTAIN"then self.status.Value=r.status.."_PRESERVED_"..operationId;error("SDK_OPERATION_"..r.status.."_PRESERVED",0)end
   assert(r.status=="PENDING"or r.status=="RUNNING"or r.status=="PENDING_RESOURCE","SDK_UNKNOWN_OPERATION_STATE")
  else self.status.Value="STATUS_READ_FAILED_PRESERVED_"..operationId end
  task.wait(self.cfg.PollIntervalSeconds or 2)
 end
 self.status.Value="POLL_DEADLINE_PRESERVED_"..operationId;error("SDK_OPERATION_DEADLINE_UNKNOWN_PRESERVED_"..operationId,0)
end
function Client:postOperation(path,body)
 local op=id(body.operationId);assert(self:_read(op)==nil,"SDK_OPERATION_ALREADY_RECORDED_NO_REPOST")
 assert(#self.ledger:GetChildren()&lt;(self.cfg.MaxOperationRecords or 128),"SDK_FINITE_OPERATION_LEDGER")
 self:_save(op,{operationId=op,status="POST_INTENT",path=path,body=body}) -- headers/token never stored
 self.status.Value="POST_INTENT_"..op
 local ok,r=pcall(function()return self:_request("POST",path,body)end)
 if ok then assert(r.operationId==op,"SDK_SUBMIT_OPERATION_ID")
 else self.status.Value="POST_UNKNOWN_PRESERVED_"..op end
 -- Even after a network/HTTP error only GET reconciliation is allowed here.
 return self:waitOperation(op)
end
function Client:postRecorded(path,body,finalStatus)
 local op=id(body.operationId);assert(self:_read(op)==nil,"SDK_OPERATION_ALREADY_RECORDED_NO_REPOST")
 self:_save(op,{operationId=op,status="POST_INTENT",path=path,body=body})
 local ok,r=pcall(function()return self:_request("POST",path,body)end)
 if not ok then self.status.Value="SYNC_POST_UNKNOWN_PRESERVED_"..op;error("SDK_SYNC_POST_UNKNOWN_PRESERVED_"..op,0)end
 self:_save(op,{operationId=op,status=finalStatus or"ACKNOWLEDGED",path=path,result=r});return r
end
function Client:mark(operationId,status)local r=assert(self:_read(operationId));r.status=status;self:_save(operationId,r)end
M.Client=Client;return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_HttpLoop"><Properties><string name="Name">HttpLoop</string><ProtectedString name="Source">-- Plomería de fases: jamás selecciona un puerto ni corrige una salidaNative.
local H=game:GetService("HttpService")
local Transport=require(script.Parent.HttpTransport)
local Bootstrap=require(script.Parent.SDKBootstrap)
local Persistence=require(script.Parent.PersistenceChecks_R06)
local Evidence=require(script.Parent.Evidence_R06)
local M={};local running={}
local allowed={ASK_STATION=true,SKIP_STATION=true,EXIT_0=true,EXIT_1=true,SAFE_WAIT=true}
local function copy(v)return H:JSONDecode(H:JSONEncode(v))end
local function setStatus(handle,value)handle.phase=value;handle.prepared.status.Value=value end
local function executeChoice(handle,kind,observation)
 local client=handle.client;local agent=handle.prepared.agent;local contract=handle.contract
 local op=client:newOperation(kind)
 setStatus(handle,"WAITING_NATIVE_"..string.upper(kind))
 local value=client:postOperation("/v1/native/"..kind,{instanceId=client.instanceId,operationId=op,sessionId=contract.sessionId,payload={observation=copy(observation)}})
 assert(type(value)=="table"and allowed[value.action]and type(value.nativeTick)=="number","SDK_UNSUPPORTED_NATIVE_RESULT_PRESERVED")
 assert(value.operation_id==nil or value.operation_id==op,"SDK_NATIVE_OPERATION_ID")
 local raw={protocol="DEE.RBX.Connector.R01",namespace=agent.namespace,sessionId=contract.sessionId,seq=observation.seq,observationId=observation.observationId,actionId=op,operationId=op,sourceKind="DEE_NATIVE",action={name=value.action,nativeTick=value.nativeTick,null=value.null,actionId=op}}
 setStatus(handle,"EXECUTING_NATIVE_"..value.action)
 local ack=agent:deliverAction(H:JSONEncode(raw))
 assert(ack.actionId==op and ack.operationId==op and ack.observationId==observation.observationId,"SDK_BODY_ACK_ID")
 local ackOp=client:newOperation("action_ack")
 local registered=client:postRecorded("/v1/action-ack",{instanceId=client.instanceId,operationId=ackOp,sessionId=contract.sessionId,actionId=op,observationId=observation.observationId,localSequence=observation.seq,ack=copy(ack)},"ACKNOWLEDGED")
 assert(registered.status=="ACKNOWLEDGED"and registered.actionId==op,"SDK_RUNTIME_ACK_REQUIRED")
 agent:confirmActionAck(op,op);client:mark(op,"ACKNOWLEDGED");handle:publishState("ACTION_ACKNOWLEDGED")
 return value,ack,op
end
local function cycle(handle)
 local agent=handle.prepared.agent;local client=handle.client;local contract=handle.contract
 assert(agent:status().phase=="BOUNDARY","SDK_BOUNDARY_BEFORE_CYCLE")
 local obs=agent:observe("QUERY_CHOICE");local choice,ack,actionId=executeChoice(handle,"decision",obs)
 local spent=assert(ack.result.permissionSpent,"SDK_COST_MEASUREMENT")
 if choice.action~="SAFE_WAIT"then
  obs=agent:observe("ROUTE_CHOICE");choice,ack,actionId=executeChoice(handle,"query_sensor",obs);spent+=assert(ack.result.permissionSpent)
 end
 assert(agent:toolRequest()==nil,"SDK_DEFAULT_MAP_TOOL_UNSUPPORTED_PRESERVED")
 local result=ack.result
 local payload={actionId=actionId,seq=obs.seq,observationId=obs.observationId,worldTimeMs=result.worldTimeMs,durationMs=result.durationMs,outcome=result.outcome,collision=result.collision,resourceCollected=result.resourceCollected,resourceDelivered=result.resourceDelivered,permissionSpent=spent,materialConsequence=result.materialConsequence,lastObservation=copy(obs)}
 local op=client:newOperation("feedback");setStatus(handle,"WAITING_NATIVE_FEEDBACK")
 local returned=client:postOperation("/v1/native/feedback",{instanceId=client.instanceId,operationId=op,sessionId=contract.sessionId,payload=payload})
 assert(type(returned)=="table"and returned.accepted==true,"SDK_FEEDBACK_NOT_ACCEPTED_PRESERVED")
 agent:completeFeedback({actionId=actionId,feedbackOperationId=op,nativeTick=returned.nativeTick});client:mark(op,"COMMITTED")
 setStatus(handle,"CYCLE_BOUNDARY_"..agent:status().completedOpportunities);handle:publishState("FEEDBACK_BOUNDARY")
end
local function saveClose(handle)
 local agent=handle.prepared.agent;local client=handle.client;local contract=handle.contract
 assert(agent:status().phase=="BOUNDARY","SDK_CLOSE_BOUNDARY_ONLY");agent:requestClose();setStatus(handle,"WAITING_NATIVE_SAVE_CLOSE")
 local closeId=client:newOperation("close")
 local result=client:postOperation("/v1/session/close",{instanceId=client.instanceId,operationId=closeId,sessionId=contract.sessionId})
 local proof=assert(result.backendProof,"SDK_NATIVE_CLOSED_PROOF_REQUIRED")
 assert(proof.backendWriterClosed==true and proof.bridgeQuiescent==true,"SDK_NATIVE_NOT_CLOSED")
 local snapshot=agent:capture(proof);handle:publish("CLOSED_CAPTURE",{snapshot=snapshot,backendProof=proof});client:mark(closeId,"COMMITTED")
 local checkpointId=client:newOperation("checkpoint")
 local sealed=client:postRecorded("/v1/checkpoint",{instanceId=client.instanceId,operationId=checkpointId,sessionId=contract.sessionId,snapshot=snapshot},"SEALED")
 assert(sealed.status=="SEALED"and sealed.nativeTick==proof.nativeTick and type(sealed.checkpointSha256)=="string","SDK_CHECKPOINT_NOT_SEALED")
 handle.checkpoint=sealed;handle.closed=true;setStatus(handle,"CLOSED_SEALED_"..sealed.checkpointId);handle:publish("PAIR_SEALED",sealed)
 if handle.cfg.AutoEndStudioTest==true then
  local s=agent:status()
  local meta={schema="DEE.SDK.RunCompletion.R06",status="CLOSED_SEALED",instanceId=client.instanceId,sessionId=contract.sessionId,lifeId=contract.lifeId,
   nativeTick=s.nativeTick,localSequence=s.sequence,completedOpportunities=s.completedOpportunities,checkpoint=sealed,restorationProof=handle.restorationProof,
   scope="Diagnostic completion metadata only; no Native answers or future choices supplied"}
  handle:publish("AUTO_END_REQUESTED_AFTER_SEAL",meta)
  local ended,endError=pcall(function()game:GetService("StudioTestService"):EndTest(meta)end)
  if not ended then handle:publish("AUTO_END_REFUSED",{error=tostring(endError)});warn("DEE_SDK_AUTO_END_REFUSED:"..tostring(endError))end
 end
end
function M.start(cfg)
 assert(cfg.Mode=="NATIVE","SDK_NATIVE_MODE_EXPLICIT_REQUIRED")
 local client=Transport.new(Transport.readPrivateConnection(cfg),cfg.Transport or{})
 assert(not running[client.instanceId],"SDK_INSTANCE_LOOP_ALREADY_EXISTS");client:assertQuiescent()
 local contract=client:waitReadyHandshake()
 assert(contract.instanceId==client.instanceId and contract.protocolVersion=="DEE.RBX.Connector.R01"and contract.runtimeVersion=="0.1.1","SDK_RUNTIME_CONTRACT_VERSION")
 assert(contract.backendKind=="NATIVE_REAL"and contract.technicalControl==false,"SDK_REAL_NATIVE_BACKEND_REQUIRED")
 local prepared=Bootstrap.prepare(cfg,contract);local agent=prepared.agent
 local handle={client=client,contract=contract,prepared=prepared,cfg=cfg,closed=false};running[client.instanceId]=handle
 function handle:requestClose()self.requestedClose=true;return self.prepared.agent:status()end
 function handle:status()return{phase=self.phase,closed=self.closed,error=self.error,checkpoint=self.checkpoint,agent=self.prepared.agent:status()}end
 Evidence.attach(handle)
 local initialized,initialError=xpcall(function()
  if contract.snapshot~=nil then
   assert(contract.backendProof~=nil and type(contract.checkpointSha256)=="string","SDK_PAIRED_RESTORE_PROOF_REQUIRED")
   local expected=copy(contract.backendProof);expected.checkpointSha256=contract.checkpointSha256
   agent:restore(contract.snapshot,expected)
   local comparison=Persistence.verifyRestore(agent,contract.snapshot)
   handle:publish("RESTORE_COMPARISON_BEFORE_OBSERVE",comparison)
   assert(comparison.passed,"R06_RESTORE_EQUALITY_FAILED_BEFORE_OBSERVE")
   local ledger=Persistence.verifyBackendLedger(client,contract,contract.snapshot)
   handle:publish("RESTORE_LEDGER_BEFORE_OBSERVE",ledger)
   local proofId=client:newOperation("restoration_proof")
   local proof={schema="DEE.RBX.RestorationProof.R06",ok=comparison.passed,differences=comparison.differences,differenceCount=comparison.differenceCount,
    poseTolerance=1e-5,actual=comparison.actual,expected=comparison.expected,backendLedgerCheck=ledger}
   local persisted=client:postRecorded("/v1/restoration-proof",{instanceId=client.instanceId,operationId=proofId,sessionId=contract.sessionId,
    checkpointSha256=contract.checkpointSha256,pairSha256=assert(contract.pairSha256,"R06_PAIR_FILE_ANCHOR_REQUIRED"),proof=proof},"COMMITTED")
   assert(persisted.operationId==proofId and persisted.status=="RECORDED"and type(persisted.restorationProofSha256)=="string","R06_RESTORATION_PROOF_NOT_DURABLE")
   handle.restorationProof=persisted;handle:publish("RESTORATION_PROOF_PERSISTED_BEFORE_OBSERVE",persisted)
  else
   assert(contract.localSequence==0 and contract.completedCycles==0,"SDK_NEW_WITH_NONZERO_CURSOR_REJECTED")
   agent:bindSession({sessionId=contract.sessionId,lifeId=contract.lifeId,nativeTick=contract.nativeTick})
   handle:publishState("NEW_BOUNDARY_BEFORE_OBSERVE")
  end
  assert(agent:status().sequence==contract.localSequence and agent:status().completedOpportunities==contract.completedCycles,"SDK_LOCAL_CURSOR_MISMATCH")
 end,function(e)return tostring(e)end)
 if not initialized then
  handle.error=initialError;setStatus(handle,"ERROR_PRESERVED_BEFORE_OBSERVE");handle:publishState("START_ERROR_PRESERVED");error(initialError,0)
 end
 task.spawn(function()
  local ok,err=xpcall(function()
   local count=cfg.RunCycles or 1;assert(type(count)=="number"and count%1==0 and count&gt;=1 and count&lt;=cfg.MaxOpportunities,"SDK_FINITE_RUN_CYCLES")
   for _=1,count do
    local s=agent:status();if handle.requestedClose or s.closeRequested or s.completedOpportunities&gt;=cfg.MaxOpportunities then break end
    assert(not client:pastHardDeadline(),"R06_HARD_DEADLINE_NO_NEW_OBSERVE")
    assert(os.time()&lt;client.lastNewUtcEpoch,"R06_LAST_NEW_DEADLINE_NO_OBSERVE")
    cycle(handle)
   end
   saveClose(handle)
  end,function(e)return tostring(e)end)
  if not ok then handle.error=err;setStatus(handle,"ERROR_PRESERVED_OWNER_RECONCILIATION_REQUIRED");handle:publishState("ERROR_PRESERVED");warn("DEE_SDK: "..err)end
 end)
 return handle
end
function M.get(instanceId)return running[instanceId]end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_LiveAdapters_R06"><Properties><string name="Name">LiveAdapters_R06</string><ProtectedString name="Source">-- Another-map pilot: fixed sensors/ports and a geometry-only Humanoid motor.
-- No target selection, anti-loop, arithmetic, teacher or Native memory edit.
local Motor=require(script.Parent.MotorPathfinding_R06)
local Persist=require(script.Parent.StateCodec_R06)
local A={}
local function pose(actor)return{actor:GetPivot():GetComponents()}end
function A.new(actor,o)
 local source=assert(o.inherited);local points=assert(o.points);local device=assert(o.device)
 local state={stock=source.permissionStock,worldTimeMs=0,signal=-1,
  inventoryKey=source.inventoryKey,inventoryResource=source.inventoryResource,
  numberAPresent=source.numberAPresent,codeBPresent=source.codeBPresent,codeBCurrent=source.codeBCurrent,
  numberAVersion=source.numberAVersion,lastFailure=false,queries=0,skips=0,moves=0,waits=0,
  sourceEnvironment=o.sourceEnvironment,rng={algorithm="NONE"},motorEvents={},contactCertain=true}
 local motor=Motor.new(actor,o.motor,function(kind,data)table.insert(state.motorEvents,{kind=kind,data=data})end,
  function(dt)state.worldTimeMs+=math.floor(dt*1000)end)
 local function contactCode()
  for code,p in pairs(points)do
   local d=motor.root.Position-p
   if Vector3.new(d.X,0,d.Z).Magnitude&lt;=o.motor.ArrivalRadius then return code end
  end
  error("R07_PILOT_PHYSICAL_CONTACT_UNKNOWN_NO_SENSOR_FABRICATED")
 end
 local world={}
 function world:capture()
  assert(not motor.active,"R07_PILOT_CAPTURE_NOT_MOVING")
  local panels={};for code,panel in pairs(o.panels)do table.insert(panels,{code=code,part=Persist.part(panel)})end
  table.sort(panels,function(a,b)return a.code&lt;b.code end)
  return{schema="DEE.SDK.World.R06",state=Persist.copy(state),device=Persist.part(device),panels=panels,motor=motor:export(),
   declaredTask="TRANSFER_OF_CONNECTOR_TO_ANOTHER_MAP_NOT_FREE_MISSION_OR_NEW_LEARNING"}
 end
 function world:restore(saved)
  assert(saved.schema=="DEE.SDK.World.R06"and saved.state.rng.algorithm=="NONE"and not motor.active,"R06_WORLD_SCHEMA")
  local count=0;for _ in pairs(o.panels)do count+=1 end;assert(count==#saved.panels,"R06_PANEL_SET_BINDING")
  motor:restore(saved.motor)
  for _,row in ipairs(saved.panels)do Persist.applyPart(assert(o.panels[row.code],"R06_PANEL_MISSING"),row.part)end
  Persist.applyPart(device,saved.device);state=Persist.copy(saved.state)
 end
 local body={}
 function body:execute(action)
  local started=os.clock();local r={before=pose(actor),collision=false,invalidAction=false,
   resourceCollected=false,resourceDelivered=false,permissionSpent=0,querySpent=0,tollSpent=0,
   outcome="WAITED",deviceBefore=device:GetAttribute("ActuatorValue")}
  if action.name=="ASK_STATION"then
   local code=contactCode();local panel=assert(o.panels[code])
   if state.stock&lt;1 or(panel.Position-motor.root.Position).Magnitude&gt;8 then
    r.invalidAction=true;r.outcome="QUERY_UNAVAILABLE"
   else
    assert(panel:GetAttribute("Signal")==1 and panel:GetAttribute("Price0")==0 and panel:GetAttribute("Price1")==0,"R07_PILOT_FIXED_PANEL")
    state.stock-=1;state.signal=1;state.queries+=1;r.permissionSpent=1;r.querySpent=1;r.outcome="PANEL_OBSERVED"
    task.wait(.1);state.worldTimeMs+=100
   end
  elseif action.name=="SKIP_STATION"then state.signal=-1;state.skips+=1;r.outcome="QUERY_OMITTED"
  elseif action.name=="SAFE_WAIT"then state.waits+=1;task.wait(.1);state.worldTimeMs+=100
  elseif action.name=="EXIT_0"or action.name=="EXIT_1"then
   local port=action.name=="EXIT_0"and 0 or 1
   -- Absolute endpoints are fixed actuator anatomy. The motor cannot substitute one.
   local result=motor:moveTo(points[port+1],action.actionId or"R07_PILOT_TRANSPORT")
   r.motor=result
   if result.status=="ARRIVED"then
    state.moves+=1;state.contactCertain=true;r.outcome="MOVED"
    device:SetAttribute("ActuatorValue",port);device.CanCollide=port==0
    device.Transparency=port==0 and .15 or .8
    device.Color=port==0 and Color3.fromRGB(220,150,70)or Color3.fromRGB(60,210,175)
    r.deviceActuation={port=port,value=device:GetAttribute("ActuatorValue"),actualCanCollide=device.CanCollide,
     semantic_choice_in_motor=false,prepared_fixed_actuator=true}
   else state.contactCertain=false;r.invalidAction=true;r.outcome="MOTOR_NO_PATH"end
   state.signal=-1
  else r.invalidAction=true;r.outcome="UNSUPPORTED_ACTION"end
  state.lastFailure=r.invalidAction or r.collision
  r.after=pose(actor);r.durationMs=math.floor((os.clock()-started)*1000);r.worldTimeMs=state.worldTimeMs
  r.deviceAfter=device:GetAttribute("ActuatorValue");r.materialConsequence=state.lastFailure
  r.preparedKinematicActuator=false;r.preparedHumanoidPathfinding=true
  return r
 end
 function body:capture()assert(not motor.active);return Persist.body(actor,motor.root)end
 function body:restore(saved)
  assert(not motor.active,"R06_BODY_RESTORE_NOT_MOVING");Persist.restoreBody(actor,motor.root,saved)
 end
 local sensors={}
 function sensors:observe(phase)
  assert(state.contactCertain,"R07_PILOT_NO_NEW_EPISODE_AFTER_UNCERTAIN_PATH")
  if phase=="QUERY_CHOICE"then state.signal=-1 end
  local code=contactCode()
  return{phase=phase,worldTimeMs=state.worldTimeMs,sampleTimeMs=state.worldTimeMs,
   sensors={station=code,stage=state.inventoryResource and 2 or 1,contact=0,
    inventoryKey=state.inventoryKey,inventoryResource=state.inventoryResource,queryAvailable=state.stock&gt;=1,
    stationSignal=state.signal,permissionStock=state.stock,publicContactCode=code,lastFailure=state.lastFailure,
    numberAPresent=state.numberAPresent,codeBPresent=state.codeBPresent,numberAVersion=state.numberAVersion,
    codeBCurrent=state.codeBCurrent,goalDelivery=true}}
 end
 return{body=body,sensors=sensors,world=world}
end
return A
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_MotorPathfinding_R06"><Properties><string name="Name">MotorPathfinding_R06</string><ProtectedString name="Source">-- Motor geometry only. The caller supplies ONE already selected destination.
-- No graph search for goals, inventory policy, novelty, anti-loop or target swap.
local PathfindingService=game:GetService("PathfindingService")
local RunService=game:GetService("RunService")
local Motor={};Motor.__index=Motor

local function part(parent,name,size,frame,color,collide)
    local p=parent:FindFirstChild(name)
    if p then assert(p:IsA("Part"),"R07_RIG_PART_CLASS");return p end
    p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=frame;p.Color=color
    p.Anchored=false;p.CanCollide=collide;p.CanTouch=true;p.CanQuery=true
    p:SetAttribute("R07PreparedBody",true);p.Parent=parent;return p
end
local function joint(parent,name,a,b,c0,c1)
    local old=parent:FindFirstChild(name)
    if old then assert(old:IsA("Motor6D"),"R07_JOINT_CLASS");return old end
    local m=Instance.new("Motor6D");m.Name=name;m.Part0=a;m.Part1=b
    m.C0=c0;m.C1=c1;m.Parent=parent;return m
end
function Motor.new(body,config,emit,onFrame)
    local self=setmetatable({},Motor)
    self.body=body;self.C=config;self.emit=emit;self.onFrame=onFrame;self.active=false
    local before=body:GetPivot();local existing={}
    for _,p in ipairs(body:GetDescendants())do if p:IsA("BasePart")then table.insert(existing,p)end end
    local root=part(body,"HumanoidRootPart",Vector3.new(2,2,1),before,Color3.fromRGB(70,205,230),false)
    root.Transparency=1;root.Anchored=true
    local torso=part(body,"Torso",Vector3.new(2,2,1),before,Color3.fromRGB(55,150,190),true)
    local head=part(body,"Head",Vector3.new(2,1,1),before*CFrame.new(0,1.5,0),Color3.fromRGB(130,225,225),false)
    local ll=part(body,"Left Leg",Vector3.new(1,2,1),before*CFrame.new(-.5,-2,0),Color3.fromRGB(55,90,130),true)
    local rl=part(body,"Right Leg",Vector3.new(1,2,1),before*CFrame.new(.5,-2,0),Color3.fromRGB(55,90,130),true)
    local la=part(body,"Left Arm",Vector3.new(1,2,1),before*CFrame.new(-1.5,0,0),Color3.fromRGB(75,175,200),false)
    local ra=part(body,"Right Arm",Vector3.new(1,2,1),before*CFrame.new(1.5,0,0),Color3.fromRGB(75,175,200),false)
    joint(root,"RootJoint",root,torso,CFrame.identity,CFrame.identity)
    joint(torso,"Neck",torso,head,CFrame.new(0,1,0),CFrame.new(0,-.5,0))
    joint(torso,"Left Hip",torso,ll,CFrame.new(-.5,-1,0),CFrame.new(0,1,0))
    joint(torso,"Right Hip",torso,rl,CFrame.new(.5,-1,0),CFrame.new(0,1,0))
    joint(torso,"Left Shoulder",torso,la,CFrame.new(-1.5,0,0),CFrame.identity)
    joint(torso,"Right Shoulder",torso,ra,CFrame.new(1.5,0,0),CFrame.identity)
    for _,p in ipairs(existing)do
        if p~=root and not p:GetAttribute("R07PreparedBody")then
            p.CanCollide=false;p.Massless=true
            if not p:FindFirstChild("R07OldVisualWeld")then
                local w=Instance.new("Weld");w.Name="R07OldVisualWeld";w.Part0=root;w.Part1=p
                w.C0=root.CFrame:ToObjectSpace(p.CFrame);w.C1=CFrame.identity;w.Parent=p
            end
        end
    end
    for _,p in ipairs(body:GetDescendants())do if p:IsA("BasePart")and p~=root then p.Anchored=false end end
    local h=body:FindFirstChildOfClass("Humanoid")or Instance.new("Humanoid")
    h.Name="Humanoid";h.RequiresNeck=false;h.BreakJointsOnDeath=false
    h.WalkSpeed=config.WalkSpeed;h.HipHeight=0;h.AutoRotate=true
    h.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;h.Parent=body
    body.PrimaryPart=root;self.root=root;self.humanoid=h
    root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
    self.emit("MOTOR_PREPARED",{kind="HUMANOID_PATHFINDING",preservedPivot={before:GetComponents()},
        semantic_destination_selected_by_motor=false})
    return self
end

function Motor:moveTo(destination,actionId)
    assert(not self.active and typeof(destination)=="Vector3","R07_SINGLE_FIXED_MOTOR_TARGET")
    self.active=true
    local selected=destination;local started=os.clock();local totalDistance=0;local old=self.root.Position
    local recomputes=0;local status="NO_PATH";local reason="NOT_COMPUTED";local pathRows={}
    self.emit("MOTOR_TARGET_ADMITTED",{actionId=actionId,selectedDestination={selected.X,selected.Y,selected.Z},
        walkSpeed=self.C.WalkSpeed,no_goal_substitution=true})
    while recomputes&lt;=self.C.MaxRecomputes and os.clock()-started&lt;self.C.MaxWallSeconds do
        local path=PathfindingService:CreatePath({AgentRadius=self.C.AgentRadius,AgentHeight=self.C.AgentHeight,
            AgentCanJump=self.C.AgentCanJump,AgentCanClimb=false,WaypointSpacing=self.C.WaypointSpacing})
        -- No semantic Costs/modifiers or desired goal can enter this service.
        local ok,err=pcall(function()path:ComputeAsync(self.root.Position,selected)end)
        if not ok or path.Status~=Enum.PathStatus.Success then reason=ok and"PATH_STATUS_NO_PATH"or tostring(err);break end
        local waypoints=path:GetWaypoints();local blocked=nil;local waypointIndex=1
        local connection=path.Blocked:Connect(function(index)if index&gt;=waypointIndex then blocked=index end end)
        self.root.Anchored=false;pcall(function()self.root:SetNetworkOwner(nil)end)
        local completed=true
        for index,waypoint in ipairs(waypoints)do
            waypointIndex=index
            if blocked or os.clock()-started&gt;=self.C.MaxWallSeconds then completed=false;reason="BLOCKED_OR_MOTOR_TIMEOUT";break end
            if waypoint.Action==Enum.PathWaypointAction.Jump then self.humanoid:ChangeState(Enum.HumanoidStateType.Jumping)end
            self.humanoid:MoveTo(waypoint.Position)
            local stepStart=os.clock();local reached=false
            while os.clock()-stepStart&lt;self.C.WaypointTimeout and os.clock()-started&lt;self.C.MaxWallSeconds do
                local dt=RunService.Heartbeat:Wait()
                totalDistance+=(self.root.Position-old).Magnitude;old=self.root.Position
                self.onFrame(dt)
                local delta=self.root.Position-waypoint.Position
                if Vector3.new(delta.X,0,delta.Z).Magnitude&lt;=self.C.ArrivalRadius then reached=true;break end
                if blocked then break end
            end
            table.insert(pathRows,{attempt=recomputes,waypoint=index,reached=reached,
                position={waypoint.Position.X,waypoint.Position.Y,waypoint.Position.Z}})
            if not reached then completed=false;reason=blocked and"PATH_BLOCKED"or"WAYPOINT_TIMEOUT";break end
        end
        connection:Disconnect()
        local delta=self.root.Position-selected
        if completed and Vector3.new(delta.X,0,delta.Z).Magnitude&lt;=self.C.ArrivalRadius then status="ARRIVED";reason="SELECTED_TARGET_REACHED";break end
        recomputes+=1
        -- Recompute only to selected, never a different station or useful tool.
    end
    self.humanoid:Move(Vector3.zero);self.root.Anchored=true
    self.root.AssemblyLinearVelocity=Vector3.zero;self.root.AssemblyAngularVelocity=Vector3.zero
    self.active=false
    local result={status=status,reason=reason,actionId=actionId,selectedDestination={selected.X,selected.Y,selected.Z},
        finalPosition={self.root.Position.X,self.root.Position.Y,self.root.Position.Z},recomputes=recomputes,
        wallSeconds=os.clock()-started,distance=totalDistance,waypoints=pathRows,no_alternate_goal=true}
    self.emit("MOTOR_RESULT",result);return result
end

function Motor:export()
    assert(not self.active and self.root.Anchored,"R07_NO_CAPTURE_DURING_MOTOR")
    return {schema="DEE.SDK.Motor.R06",active=false,rootAnchored=self.root.Anchored,
        walkSpeed=self.humanoid.WalkSpeed,hipHeight=self.humanoid.HipHeight,
        autoRotate=self.humanoid.AutoRotate,parameters=game:GetService("HttpService"):JSONDecode(game:GetService("HttpService"):JSONEncode(self.C))}
end
function Motor:restore(saved)
    assert(saved.schema=="DEE.SDK.Motor.R06"and saved.active==false and saved.rootAnchored==true and not self.active,"R06_MOTOR_RESTORE_BOUNDARY")
    local function same(a,b)
        if type(a)~=type(b)then return false end
        if type(a)~="table"then return a==b end
        for k,v in pairs(a)do if not same(v,b[k])then return false end end
        for k in pairs(b)do if a[k]==nil then return false end end;return true
    end
    assert(same(saved.parameters,self.C),"R06_MOTOR_PARAMETERS_BINDING")
    self.C=game:GetService("HttpService"):JSONDecode(game:GetService("HttpService"):JSONEncode(saved.parameters))
    self.active=saved.active;self.root.Anchored=saved.rootAnchored;self.humanoid.WalkSpeed=saved.walkSpeed;self.humanoid.HipHeight=saved.hipHeight;self.humanoid.AutoRotate=saved.autoRotate
end
return Motor
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_StateCodec_R06"><Properties><string name="Name">StateCodec_R06</string><ProtectedString name="Source">-- Persistencia de propiedades capturadas. Sin sensores, decisiones ni avanceNative.
local H=game:GetService("HttpService")
local M={}
function M.copy(v)return H:JSONDecode(H:JSONEncode(v))end
function M.frame(f)return{f:GetComponents()}end
function M.vec(v)return{v.X,v.Y,v.Z}end
function M.part(p)
 return{name=p.Name,className=p.ClassName,cframe=M.frame(p.CFrame),size=M.vec(p.Size),anchored=p.Anchored,
  canCollide=p.CanCollide,canQuery=p.CanQuery,canTouch=p.CanTouch,massless=p.Massless,
  transparency=p.Transparency,color={p.Color.R,p.Color.G,p.Color.B},material=p.Material.Name,
  collisionGroup=p.CollisionGroup,linearVelocity=M.vec(p.AssemblyLinearVelocity),angularVelocity=M.vec(p.AssemblyAngularVelocity),attributes=p:GetAttributes()}
end
function M.applyPart(p,s)
 assert(p.Name==s.name and p.ClassName==s.className,"R06_PART_BINDING")
 p.Anchored=true;p.Size=Vector3.new(table.unpack(s.size));p.CFrame=CFrame.new(table.unpack(s.cframe))
 p.CanCollide=s.canCollide;p.CanQuery=s.canQuery;p.CanTouch=s.canTouch;p.Massless=s.massless
 p.Transparency=s.transparency;p.Color=Color3.new(table.unpack(s.color));p.Material=assert(Enum.Material[s.material],"R06_PART_MATERIAL")
 p.CollisionGroup=s.collisionGroup
 for k in pairs(p:GetAttributes())do if s.attributes[k]==nil then p:SetAttribute(k,nil)end end
 for k,v in pairs(s.attributes)do p:SetAttribute(k,v)end
 p.AssemblyLinearVelocity=Vector3.new(table.unpack(s.linearVelocity));p.AssemblyAngularVelocity=Vector3.new(table.unpack(s.angularVelocity))
 p.Anchored=s.anchored
end
function M.body(actor,root)
 assert(root.Anchored,"R06_CAPTURE_BODY_ANCHORED")
 local parts,joints={},{}
 for _,p in ipairs(actor:GetDescendants())do
  if p:IsA("BasePart")then table.insert(parts,M.part(p))
  elseif p:IsA("JointInstance")then table.insert(joints,{name=p.Name,className=p.ClassName,parent=p.Parent.Name,part0=p.Part0 and p.Part0.Name,part1=p.Part1 and p.Part1.Name,c0=M.frame(p.C0),c1=M.frame(p.C1),transform=p:IsA("Motor6D")and M.frame(p.Transform)or nil})end
 end
 table.sort(parts,function(a,b)return a.name&lt;b.name end);table.sort(joints,function(a,b)return(a.parent.."/"..a.name)&lt;(b.parent.."/"..b.name)end)
 return{schema="DEE.SDK.Body.R06",pose=M.frame(actor:GetPivot()),rootName=root.Name,rootAnchored=root.Anchored,parts=parts,joints=joints}
end
function M.restoreBody(actor,root,s)
 assert(s.schema=="DEE.SDK.Body.R06"and s.rootName==root.Name and s.rootAnchored==true,"R06_BODY_BINDING")
 local found={};for _,p in ipairs(actor:GetDescendants())do if p:IsA("BasePart")then assert(not found[p.Name],"R06_BODY_PART_NAME_DUPLICATE");found[p.Name]=p;p.Anchored=true end end
 local n=0;for _ in pairs(found)do n+=1 end;assert(n==#s.parts,"R06_BODY_PART_SET")
 actor:PivotTo(CFrame.new(table.unpack(s.pose))) -- explicit paired restore only
 for _,j in ipairs(s.joints)do
  local parent=actor:FindFirstChild(j.parent,true);local live=parent and parent:FindFirstChild(j.name)
  assert(live and live:IsA("JointInstance")and live.ClassName==j.className and live.Part0 and live.Part1 and live.Part0.Name==j.part0 and live.Part1.Name==j.part1,"R06_JOINT_BINDING")
  live.C0=CFrame.new(table.unpack(j.c0));live.C1=CFrame.new(table.unpack(j.c1));if j.transform then assert(live:IsA("Motor6D"),"R06_JOINT_TRANSFORM");live.Transform=CFrame.new(table.unpack(j.transform))end
 end
 for _,p in ipairs(s.parts)do M.applyPart(assert(found[p.name],"R06_BODY_PART_MISSING"),p)end
 assert(root.Anchored,"R06_RESTORE_ROOT_MUST_STAY_ANCHORED")
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_PersistenceChecks_R06"><Properties><string name="Name">PersistenceChecks_R06</string><ProtectedString name="Source">-- ComparaciónRO completa antes de nuevaobserve. Sólo pose/CFrame admite1e-5.
local H=game:GetService("HttpService")
local M={}
local function copy(v)return H:JSONDecode(H:JSONEncode(v))end
local function records(folder)local r={};for _,v in ipairs(folder:GetChildren())do r[v.Name]=H:JSONDecode(v.Value)end;return r end
function M.inspect(agent)
 return{namespace=agent.namespace,scenarioFingerprint=agent.runtime.config.ScenarioFingerprint,
  bindings=copy(agent.runtime.config.PersistenceBinding),state=agent:status(),actions=records(agent.node.Actions),tools=records(agent.node.Tools),
  body=agent.adapters.body:capture(),world=agent.adapters.world:capture()}
end
local banned={actions=true,tools=true,bindings=true,state=true,namespace=true,scenariofingerprint=true}
local function poseField(k)
 if type(k)~="string"then return false end;k=string.lower(k)
 return k=="c0"or k=="c1"or string.match(k,"pose$")~=nil or string.match(k,"cframe$")~=nil or string.match(k,"transform$")~=nil
end
function M.compare(expected,actual)
 local differences={};local checked=0;local total=0
 local function diff(path,reason,a,b)total+=1;if #differences&lt;64 then table.insert(differences,{path=path,reason=reason,expected=a,actual=b})end end
 local function visit(a,b,path,tolerant,allowPose)
  checked+=1
  if type(a)~=type(b)then diff(path,"TYPE",type(a),type(b));return end
  if type(a)~="table"then
   if type(a)=="number"and tolerant then if math.abs(a-b)&gt;1e-5 then diff(path,"POSE_TOLERANCE",a,b)end
   elseif a~=b then diff(path,"VALUE",a,b)end;return
  end
  for k,v in pairs(a)do
   local p=path.."/"..tostring(k)
   local allowed=allowPose;if path==""then allowed=k=="body"or k=="world"end
   if type(k)=="string"and banned[string.lower(k)]then allowed=false end
   if b[k]==nil then diff(p,"MISSING_ACTUAL",type(v),nil)else visit(v,b[k],p,allowed and(tolerant or poseField(k)),allowed)end
  end
  for k,v in pairs(b)do if a[k]==nil then diff(path.."/"..tostring(k),"UNEXPECTED_ACTUAL",nil,type(v))end end
 end
 visit(expected,actual,"",false,false)
 return{passed=total==0,checkedValues=checked,differenceCount=total,differences=differences,poseTolerance=1e-5}
end
function M.verifyRestore(agent,snapshot)
 local expected={namespace=snapshot.namespace,scenarioFingerprint=snapshot.scenarioFingerprint,bindings=copy(snapshot.bindings),
  state=copy(snapshot.state),actions=copy(snapshot.actions),tools=copy(snapshot.tools),body=copy(snapshot.body),world=copy(snapshot.world)}
 assert(expected.state.phase=="BOUNDARY","R06_RESTORE_EXPECTED_BOUNDARY")
 expected.state.closeRequested=false -- único cambio explícito de habilitación; sin resetearotro campo.
 local actual=M.inspect(agent);local result=M.compare(expected,actual)
 result.schema="DEE.SDK.RestoreEquality.R06";result.kind="BEFORE_FIRST_NEW_OBSERVE_READ_ONLY";result.nativeExecuted=false
 result.allowedTransition="state.closeRequested true-&gt;false only";result.expected=expected;result.actual=actual
 return result
end
function M.verifyBackendLedger(client,contract,snapshot)
 local acknowledged={};for _,v in ipairs(assert(contract.acknowledgedActionIds,"R06_ACK_LEDGER_METADATA_REQUIRED"))do acknowledged[v]=true end
 local checked={}
 for id,receipt in pairs(snapshot.actions)do
  assert(acknowledged[id],"R06_BACKEND_ACTION_ACK_MISSING")
  local wire=H:JSONDecode(receipt.rawRequest);local row=client:operationStatus(id)
  assert(row.operationId==id and row.status=="COMPLETED"and type(row.value)=="table","R06_BACKEND_ACTION_NOT_COMPLETED")
  assert(row.value.action==wire.action.name and row.value.nativeTick==wire.action.nativeTick and row.value.null==wire.action.null,"R06_BACKEND_ACTION_BINDING")
  table.insert(checked,{operationId=id,kind=row.kind,action=row.value.action,nativeTick=row.value.nativeTick,acknowledged=true})
 end
 local feedbackId=assert(snapshot.state.lastFeedbackOperationId,"R06_FEEDBACK_ID_REQUIRED")
 local feedback=client:operationStatus(feedbackId)
 assert(feedback.operationId==feedbackId and feedback.status=="COMPLETED"and feedback.value.accepted==true and feedback.value.nativeTick==snapshot.state.nativeTick,"R06_BACKEND_FEEDBACK_BINDING")
 assert(contract.completedCycles==snapshot.state.completedOpportunities,"R06_BACKEND_CYCLE_CURSOR")
 return{passed=true,actionOperations=checked,feedbackOperationId=feedbackId,completedCycles=contract.completedCycles,kind="GET_ONLY_DURABLE_LEDGER_CHECK"}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_R06_Evidence_R06"><Properties><string name="Name">Evidence_R06</string><ProtectedString name="Source">-- SalidaRO enVMnormal; no requierelookupdelcacheMCP. Nunca observa, actúa o llamaNative.
local H=game:GetService("HttpService");local SS=game:GetService("ServerStorage")
local M={}
local function folder(parent,name)local f=parent:FindFirstChild(name);if f then assert(f:IsA("Folder"),"R06_EVIDENCE_CONFLICT");return f end;f=Instance.new("Folder");f.Name=name;f.Parent=parent;return f end
function M.attach(handle)
 local root=folder(SS,"DEE_SDK_R06_EVIDENCE");local f=folder(root,handle.client.instanceId)
 assert(not f:FindFirstChild("ReadOnlyExport"),"R06_EVIDENCE_ALREADY_BOUND")
 local counter=0
 local function inspect()
  local agent=handle.prepared.agent;local o={schema="DEE.SDK.ReadOnlyState.R06",checkpoint=false,agent=agent:status(),phase=handle.phase,native=false}
  local bOk,b=pcall(function()return agent.adapters.body:capture()end);o.bodyCaptureOK=bOk;if bOk then o.body=b else o.bodyError=tostring(b)end
  local wOk,w=pcall(function()return agent.adapters.world:capture()end);o.worldCaptureOK=wOk;if wOk then o.world=w else o.worldError=tostring(w)end
  return o
 end
 local bridge=Instance.new("BindableFunction");bridge.Name="ReadOnlyExport";bridge.OnInvoke=function()return H:JSONEncode(inspect())end;bridge.Parent=f
 function handle:publish(kind,data)
  counter+=1;local v=Instance.new("StringValue");v.Name=string.format("E%04d_%s",counter,kind)
  v.Value=H:JSONEncode({schema="DEE.SDK.Event.R06",kind=kind,instanceId=self.client.instanceId,sessionId=self.contract.sessionId,data=data});v.Parent=f
 end
 function handle:publishState(kind)self:publish(kind,inspect())end
 return f
end
return M
