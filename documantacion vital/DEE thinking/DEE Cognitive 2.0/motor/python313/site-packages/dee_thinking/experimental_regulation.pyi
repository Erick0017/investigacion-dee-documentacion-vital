from typing import Any
from ._native import OrganizationalWorld
class CPC5RegulationSession:
    world: OrganizationalWorld
    geometry: dict[str, Any]
    mode: str
    journal: list[dict[str, Any]]
    @classmethod
    def create(cls, *, mode: str = ..., translation: tuple[int,int,int] = ..., a_history: int = ..., c_history: int = ...) -> CPC5RegulationSession: ...
    @property
    def tick(self) -> int: ...
    def run_until(self, tick: int) -> dict[str, Any]: ...
    def observe(self) -> dict[str, Any]: ...
    def save_snapshot(self, path: Any) -> dict[str, Any]: ...
    @classmethod
    def load_snapshot(cls, path: Any) -> CPC5RegulationSession: ...
    def fork(self) -> CPC5RegulationSession: ...
def create_cpc5_regulation(**options: Any) -> CPC5RegulationSession: ...
