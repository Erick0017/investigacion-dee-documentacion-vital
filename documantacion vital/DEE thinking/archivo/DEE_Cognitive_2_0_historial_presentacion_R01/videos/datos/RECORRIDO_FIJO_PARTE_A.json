{
  "schema": "DEE20.fixed_operator_http_itinerary.v1",
  "life_id": "DEE20_DEMO_01",
  "scope": "Fixed operator itinerary, frozen before the only demonstration. No answer-conditioned branching, retries, resets or changes of life.",
  "steps": [
    {"id":"a00_session","kind":"session","deadline_seconds":30},
    {"id":"a01_intro","kind":"presentation","payload":{"focus":"top","sections":[],"label":"Recorrido programado por el operador. Una sola copia; las respuestas no están fijadas."},"hold_seconds":5},
    {"id":"a02_open","kind":"action","payload":{"action":"abrir"},"hold_seconds":4},
    {"id":"a03_initial_frame","kind":"observe","path":"/api/frame"},
    {"id":"a04_world","kind":"presentation","payload":{"focus":"world","yaw":0.66,"pitch":-0.38,"zoom":1.3,"field":"semantic","label":"Visor pasivo del mismo propietario. Cámara y colores son instrumentos, no acciones de DEE."},"hold_seconds":5},
    {"id":"a05_rotate","kind":"presentation","payload":{"focus":"world","yaw":1.5,"pitch":-0.6,"zoom":1.5,"field":"direction"},"hold_seconds":5},
    {"id":"a06_cell","kind":"presentation","payload":{"focus":"cell","coordinate":[15,17,15],"field":"s_reg","label":"Campos exactos del sitio seleccionado; el uint64 no se convierte en un color ni en un float."},"hold_seconds":7},
    {"id":"a07_resume","kind":"action","payload":{"action":"vivir"}},
    {"id":"a08_log","kind":"action","payload":{"action":"grabar"}},
    {"id":"a09_requests","kind":"presentation","payload":{"focus":"events","sections":[],"label":"Peticiones del operador: cada recibo distingue entrada aplicada, emisión y consecuencia."},"hold_seconds":2},
    {"id":"a10_alfa","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_alfa_01","texto":"palabra alfa"}},"hold_seconds":4},
    {"id":"a11_luma","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_luma_01","texto":"palabra luma"}},"hold_seconds":4},
    {"id":"a12_nara","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_nara_01","texto":"palabra nara"}},"hold_seconds":4},
    {"id":"a13_clasifica","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_clasifica_01","texto":"palabra clasifica"}},"hold_seconds":4},
    {"id":"a14_equilibra","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_equilibra_01","texto":"palabra equilibra"}},"hold_seconds":4},
    {"id":"a15_sum","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_suma_01","texto":"usar suma 4 5"}},"hold_seconds":5},
    {"id":"a16_difference","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_diferencia_01","texto":"usar diferencia 11 4"}},"hold_seconds":5},
    {"id":"a17_compare","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_compara_01","texto":"lenguaje compara 27 alfa"}},"hold_seconds":4},
    {"id":"a18_remember","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_recuerda_01","texto":"lenguaje recuerda 27 alfa"}},"hold_seconds":4},
    {"id":"a19_accumulate","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_acumular_01","texto":"acumular 3 --demora 1"}},"hold_seconds":5},
    {"id":"a20_teaching_view","kind":"presentation","payload":{"focus":"command","sections":["teaching"],"label":"UNA revisión docente explícita de clasifica a -1. No se altera una respuesta desde Python."},"hold_seconds":4},
    {"id":"a21_revision","kind":"action","payload":{"action":"ensenar","value":{"id":"dee20_demo_revision_clasifica_01","forma":"clasifica","senal":-1,"revision":true}},"hold_seconds":4},
    {"id":"a22_revision_use","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_clasifica_post_01","texto":"palabra clasifica"}},"hold_seconds":5},
    {"id":"a23_old_luma","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_luma_post_01","texto":"palabra luma"}},"hold_seconds":4},
    {"id":"a24_old_nara","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_nara_post_01","texto":"palabra nara"}},"hold_seconds":4},
    {"id":"a25_sequences_view","kind":"presentation","payload":{"focus":"events","sections":[],"label":"Combinación 1: orden indicado por el operador; la salida real de la primera operación alimenta la segunda."},"hold_seconds":3},
    {"id":"a26_composition","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_componer_01","texto":"componer suma diferencia --datos 4 5 2"}},"hold_seconds":7},
    {"id":"a27_goal_view","kind":"presentation","payload":{"focus":"events","label":"Combinación 2: una tarea con dato privado del entorno. No se entrega la estrategia correcta al ente."},"hold_seconds":3},
    {"id":"a28_goal","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_objetivo_01","texto":"objetivo suma 8 6 --oculto --contexto-ambiente 1"}},"hold_seconds":4},
    {"id":"a29_goal_opportunities","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_paso_01","texto":"paso 2"}},"hold_seconds":7},
    {"id":"a30_versions_view","kind":"presentation","payload":{"focus":"command","sections":["versions"],"label":"Vigencia: sensores preparados P0 y caché ambiental. No se atribuye memoria externa a DEE."},"hold_seconds":4},
    {"id":"a31_version_state","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_vigencia_estado_01","texto":"vigencia estado"}},"hold_seconds":4},
    {"id":"a32_version_opportunities","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_vigencia_vivir_01","texto":"vigencia vivir 2"}},"hold_seconds":7},
    {"id":"a33_pause","kind":"action","payload":{"action":"pausar"},"hold_seconds":5},
    {"id":"a34_paused_frame","kind":"observe","path":"/api/frame"},
    {"id":"a35_rest_view","kind":"presentation","payload":{"focus":"world","yaw":0.3,"pitch":-0.25,"zoom":1.4,"field":"clock","sections":["continuity"],"label":"Pausa: no avanzan ticks. Después: 67 ticks explícitos sin tarea nueva, sin limpieza ni recuperación prometida."},"hold_seconds":4},
    {"id":"a36_resume_rest","kind":"action","payload":{"action":"vivir"}},
    {"id":"a37_rest","kind":"action","payload":{"action":"reposo","value":{"ticks":67}},"hold_seconds":5},
    {"id":"a38_retention_view","kind":"presentation","payload":{"focus":"events","sections":[],"label":"Comprobación posterior a usos combinados y reposo: una asociación anterior y la revisada."}},
    {"id":"a39_rest_luma","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_luma_postreposo_01","texto":"palabra luma"}},"hold_seconds":4},
    {"id":"a40_rest_revision","kind":"action","payload":{"action":"ejecutar","value":{"id":"dee20_demo_clasifica_postreposo_01","texto":"palabra clasifica"}},"hold_seconds":4},
    {"id":"a41_pause_save","kind":"action","payload":{"action":"pausar"}},
    {"id":"a42_close_jsonl","kind":"action","payload":{"action":"grabar"}},
    {"id":"a43_export_context","kind":"action","payload":{"action":"exportar"},"hold_seconds":4},
    {"id":"a44_save","kind":"action","payload":{"action":"guardar"}},
    {"id":"a45_stop","kind":"action","payload":{"action":"detener"},"hold_seconds":4},
    {"id":"a46_closure_view","kind":"presentation","payload":{"focus":"top","sections":[],"label":"Estado guardado y propietario detenido. Se cerrará HTTP y se abrirá la MISMA vida, no otra importación."},"hold_seconds":4},
    {"id":"a47_final_status","kind":"observe"},
    {"id":"a48_shutdown","kind":"shutdown","hold_seconds":5}
  ]
}
