from typing import Any
from os import PathLike
from ._native import OrganizationalWorld
class RemoteReaderSession:
    world: OrganizationalWorld
    geometry: dict[str,Any]
    state: dict[str,Any]
    identifier: str
    storage_proof: dict[str,Any] | None
    @classmethod
    def create(cls, *, backend: str = 'LAZY', threads: int = 1, identifier: str = 'REMOTE_READER') -> RemoteReaderSession: ...
    @property
    def tick(self) -> int: ...
    @property
    def readings(self) -> list[dict[str,Any]]: ...
    def stimulate(self, requests: list[dict[str,Any]]) -> list[dict[str,Any]]: ...
    def experience_order(self, order: str, *, event_payload: int = 5, reader: bool = True) -> list[dict[str,Any]]: ...
    def acquire_sources(self, p: int = 1, q: int = -1, *, mode: str = 'paired') -> list[dict[str,Any]]: ...
    def consequence(self, value: int, *, tick: int = 11, payload: int = 17) -> list[dict[str,Any]]: ...
    def late_use(self, *, payload: int = 13) -> list[dict[str,Any]]: ...
    def teach_first_form(self, *, mode: str = 'paired', payload: int = 5) -> list[dict[str,Any]]: ...
    def query_first_form(self, *, tick: int = 50, payload: int = 11, remote_reader: bool = True) -> list[dict[str,Any]]: ...
    def learn_second_form(self, *, mode: str = 'paired') -> list[dict[str,Any]]: ...
    def observe(self) -> dict[str,Any]: ...
    def read_current_reader(self) -> dict[str,Any]: ...
    def run_until(self, tick: int) -> dict[str,Any]: ...
    def receipts(self) -> list[dict[str,Any]]: ...
    def save_snapshot(self, path: str | PathLike[str], *, compress: bool | None = None, overwrite: bool = False) -> dict[str,Any]: ...
    @classmethod
    def load_snapshot(cls, path: str | PathLike[str], *, max_bytes: int = ..., expected_sha256: str | None = None) -> RemoteReaderSession: ...
    def fork(self, *, identifier: str | None = None) -> RemoteReaderSession: ...
    def diagnostic_remote_cut(self, *, sham: bool = False) -> RemoteReaderSession: ...
