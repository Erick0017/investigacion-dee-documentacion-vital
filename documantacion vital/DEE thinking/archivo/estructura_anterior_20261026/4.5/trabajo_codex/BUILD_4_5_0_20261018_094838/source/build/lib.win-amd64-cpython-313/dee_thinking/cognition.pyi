from pathlib import Path
from typing import Any, Mapping, Sequence
from ._native import OrganizationalWorld

PROFILES: tuple[str, ...]
def record(value: Any) -> dict[str, Any]: ...
class Session:
    native: Any
    profile: str
    def __init__(self, implementation: Any, profile: str) -> None: ...
    @property
    def tick(self) -> int: ...
    @property
    def preferred_horizon(self) -> int | None: ...
    @property
    def world(self) -> OrganizationalWorld: ...
    @property
    def journal(self) -> Any: ...
    @property
    def interface_metadata(self) -> dict[str, str]: ...
    def set_interface_metadata(self, metadata: dict[str, str]) -> None: ...
    def observe(self) -> dict[str, Any]: ...
    def sense(self) -> dict[str, Any]: ...
    def predict(self, horizon: int | None = None) -> dict[str, Any]: ...
    def compare(self) -> dict[str, Any]: ...
    def source(self) -> dict[str, Any]: ...
    def experience(self, symbol: str) -> dict[str, Any]: ...
    def advance(self, ticks: int = 1) -> dict[str, Any]: ...
    def run_until(self, absolute_tick: int) -> dict[str, Any]: ...
    def train(self, teachers: Sequence[int], cue: int = 5, mode: str = "paired") -> dict[str, Any]: ...
    def train_all(self, pairs: Sequence[tuple[int, int]]) -> dict[str, Any]: ...
    def query(self, value: int) -> dict[str, Any]: ...
    def query_port(self, port: int, value: int) -> dict[str, Any]: ...
    def query_sequence(self, values: Sequence[int]) -> dict[str, Any]: ...
    def fork(self) -> Session: ...
    def save_snapshot(self, path: str | Path, *, include_trace: bool = True) -> dict[str, Any]: ...
class CompositionSession(Session):
    def __init__(self, world: OrganizationalWorld) -> None: ...
    def fork(self) -> CompositionSession: ...
def create_session(profile: str = "continuidad", **preparation: Any) -> Session: ...
def load_session(path: str | Path, *, profile: str = "continuidad") -> Session: ...
