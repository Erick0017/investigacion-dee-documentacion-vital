from typing import Any, Mapping, Sequence
from os import PathLike
from ._native import OrganizationalWorld, NativePreparation, Backend

SESSION_METADATA_KEY: str
MAX_JOURNAL_REQUESTS: int
def exact_observation(observation: Any) -> dict[str, Any]: ...
def exact_receipt(receipt: Any, identifier: int | None = None) -> dict[str, Any]: ...
def directional_readout(value: Any) -> dict[str, Any]: ...

class ConsolidatedSession:
    world: OrganizationalWorld
    preparation: NativePreparation
    identifier: str
    session_kind: str
    storage_proof: dict[str, Any] | None
    @property
    def tick(self) -> int: ...
    @property
    def dimension(self) -> int: ...
    @property
    def geometry(self) -> dict[str, Any]: ...
    @property
    def journal(self) -> list[dict[str, Any]]: ...
    @property
    def queries(self) -> list[dict[str, Any]]: ...
    @property
    def forms(self) -> tuple[str, ...]: ...
    def receipts(self) -> list[dict[str, Any]]: ...
    def submit(self, port: str, payload: int, tick: int, *, probe: bool = False) -> dict[str, Any]: ...
    def acquire(self, form: str | int, consequence: int, tick: int, *, cue: int = 5, teacher: int = 11, mode: str = "paired") -> list[dict[str, Any]]: ...
    def experience(self, form: str | int, consequence: int, tick: int, *, cue: int = 5, teacher: int = 11, mode: str = "paired") -> list[dict[str, Any]]: ...
    def acquire_block(self, observations: Mapping[str | int, int], tick: int, *, cue: int = 5, teacher: int = 11, mode: str = "paired") -> list[dict[str, Any]]: ...
    def revise(self, form: str | int, consequence: int, tick: int, *, method: str = "double_teacher", mode: str = "treatment", cue: int = 5, teacher: int = 11) -> list[dict[str, Any]]: ...
    def update(self, form: str | int, consequence: int, tick: int, *, method: str = "double_teacher", mode: str = "treatment", cue: int = 5, teacher: int = 11) -> list[dict[str, Any]]: ...
    def schedule_query(self, forms: str | int | Sequence[str | int], tick: int, *, payload: int = 5) -> dict[str, Any]: ...
    def query(self, forms: str | int | Sequence[str | int], tick: int | None = None, *, payload: int = 5) -> dict[str, Any]: ...
    def run_until(self, tick: int) -> dict[str, Any]: ...
    def advance_to(self, tick: int) -> dict[str, Any]: ...
    def advance(self, ticks: int = 1) -> dict[str, Any]: ...
    def observe(self, form: str | int | None = None) -> dict[str, Any]: ...
    def save_snapshot(self, path: str | PathLike[str], *, compress: bool | None = None, include_trace: bool = True, overwrite: bool = False) -> dict[str, Any]: ...
    def save(self, path: str | PathLike[str], *, compress: bool | None = None, include_trace: bool = True, overwrite: bool = False) -> dict[str, Any]: ...
    @classmethod
    def attach(cls, world: OrganizationalWorld, *, identifier: str = "DEE") -> ConsolidatedSession: ...
    @classmethod
    def load_snapshot(cls, path: str | PathLike[str], *, max_bytes: int = ..., expected_sha256: str | None = None, allow_legacy: bool = False) -> ConsolidatedSession: ...
    @classmethod
    def load(cls, path: str | PathLike[str], *, max_bytes: int = ..., expected_sha256: str | None = None, allow_legacy: bool = False) -> ConsolidatedSession: ...
    def fork(self, identifier: str | None = None) -> ConsolidatedSession: ...

class RepertoireSession(ConsolidatedSession):
    @classmethod
    def create(cls, *, count: int = 16, dimension: int | None = None, plane_gap: int = 2, translation: Sequence[int] = (0, 0, 0), revision_interfaces: bool = True, revision_form: int = 0, backend: str | Backend = "LAZY", threads: int = 1, identifier: str = "REPERTOIRE") -> RepertoireSession: ...

class IntegratedSession(ConsolidatedSession):
    @classmethod
    def create(cls, *, center: Sequence[int] = (33, 25, 42), guard_mode: str = "treatment", revision_interfaces: bool = True, body_source_load: int = 0, backend: str | Backend = "LAZY", threads: int = 1, identifier: str = "U0") -> IntegratedSession: ...
    def experience_order(self, order: str, *, payload: int = 3, reader_payload: int = 7) -> list[dict[str, Any]]: ...
    def consequence(self, value: int, *, tick: int = 11, payload: int = 17) -> list[dict[str, Any]]: ...
    def action(self, *, tick: int = 69, payload: int = 7) -> list[dict[str, Any]]: ...
    def teach_form(self, *, tick: int = 72, payload: int = 5, mode: str = "paired") -> list[dict[str, Any]]: ...
    def schedule_form_query(self, tick: int = 139, *, payload: int = 5) -> dict[str, Any]: ...
    def query_form(self, tick: int = 139, *, payload: int = 5) -> dict[str, Any]: ...

def create_integrated_session(**preparation: Any) -> IntegratedSession: ...
def create_repertoire_session(**preparation: Any) -> RepertoireSession: ...
def load_nsm_catalogue() -> dict[str, Any]: ...
def load_nsm_scope() -> dict[str, Any]: ...
def load_consolidated_session(path: str | PathLike[str], *, max_bytes: int = ..., expected_sha256: str | None = None, allow_legacy: bool = False) -> ConsolidatedSession: ...
