+A = (1, 0, 0)
+B = (0, 1, 0)
+SENSOR = (-1, 0, 1)
+NORMALIZER = (1, 0, -1)
+PENALTY0 = (-1, 1, 0)
+ACTION1 = (-1, 1, 1)
